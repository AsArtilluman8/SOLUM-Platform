<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.version" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <application
        android:theme="@style/SolumTheme"
        android:label="SOLUM Engine"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".FilamentGlbPreviewActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
    </application>
</manifest>
