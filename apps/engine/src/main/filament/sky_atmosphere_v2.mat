material {
    name : sky_atmosphere_v2,
    shadingModel : unlit,
    depthWrite : false,
    depthCulling : false,
    doubleSided : true,
    parameters : [
        { type : float4, name : zenithColor },
        { type : float4, name : horizonColor },
        { type : float4, name : groundColor },
        { type : float4, name : sunColor },
        { type : float3, name : sunDirection },
        { type : float3, name : skyCenter },
        { type : float, name : sunDiskIntensity },
        { type : float, name : sunGlowIntensity },
        { type : float, name : horizonSoftness },
        { type : float, name : gradientStrength },
        { type : float, name : horizonBandStrength },
        { type : float, name : sunGlowStrength },
        { type : float, name : minBrightness },
        { type : float, name : visualMode },
        { type : float, name : nightFactor },
        { type : float, name : dawnDuskFactor },
        { type : float, name : exposure }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float3 direction = normalize(getWorldPosition().xyz - materialParams.skyCenter);
        float gradientStrength = clamp(materialParams.gradientStrength, 0.35, 4.0);
        float horizonBandStrength = clamp(materialParams.horizonBandStrength, 0.0, 4.0);
        float sunGlowStrength = clamp(materialParams.sunGlowStrength, 0.0, 4.0);
        float proofMode = step(0.5, materialParams.visualMode);
        float minBrightness = clamp(materialParams.minBrightness, 0.0, 1.0);
        float height = clamp(direction.y * 0.5 + 0.5, 0.0, 1.0);
        float horizonWidth = clamp(materialParams.horizonSoftness, 0.04, 0.70);
        float upperBlend = smoothstep(0.47 - horizonWidth * 0.40, 0.94, height);
        float lowerBlend = smoothstep(0.00, 0.54 + horizonWidth * 0.34, height);
        upperBlend = pow(upperBlend, 1.0 / gradientStrength);
        lowerBlend = pow(lowerBlend, 1.0 / max(gradientStrength * 0.85, 0.35));

        float3 belowHorizon = mix(materialParams.groundColor.rgb, materialParams.horizonColor.rgb, lowerBlend);
        float3 skyGradient = mix(belowHorizon, materialParams.zenithColor.rgb, upperBlend);
        float horizonBand = 1.0 - smoothstep(0.0, horizonWidth, abs(direction.y));
        skyGradient = mix(skyGradient, materialParams.horizonColor.rgb, clamp(horizonBand * horizonBandStrength * 0.70, 0.0, 0.95));

        float sunAlignment = clamp(dot(direction, normalize(-materialParams.sunDirection)), 0.0, 1.0);
        float glowCore = pow(sunAlignment, mix(96.0, 56.0, proofMode)) * materialParams.sunDiskIntensity;
        float glowHalo = pow(sunAlignment, mix(8.0, 5.0, proofMode)) * materialParams.sunGlowIntensity * sunGlowStrength;
        float sunsetBand = materialParams.dawnDuskFactor * smoothstep(0.03, 0.66, 1.0 - abs(direction.y));
        float nightClamp = mix(
            1.0 - clamp(materialParams.nightFactor * 0.72, 0.0, 0.82),
            1.0 - clamp(materialParams.nightFactor * 0.32, 0.0, 0.48),
            proofMode
        );

        float3 color = skyGradient;
        color = mix(color, materialParams.sunColor.rgb, clamp(glowHalo * (0.32 + sunsetBand * 0.68), 0.0, 0.92));
        color = mix(color, materialParams.sunColor.rgb, clamp(sunsetBand * horizonBand * 0.58 * horizonBandStrength, 0.0, 0.86));
        color += materialParams.sunColor.rgb * glowCore;
        color *= materialParams.exposure * nightClamp;
        color = max(color, float3(minBrightness));

        material.baseColor = float4(color, 1.0);
    }
}
