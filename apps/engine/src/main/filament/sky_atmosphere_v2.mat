material {
    name : sky_atmosphere_v2,
    shadingModel : unlit,
    depthWrite : false,
    depthCulling : false,
    doubleSided : true,
    parameters : [
        { type : float4, name : zenithColor },
        { type : float4, name : horizonColor },
        { type : float4, name : groundColor },
        { type : float4, name : sunColor },
        { type : float3, name : sunDirection },
        { type : float3, name : skyCenter },
        { type : float, name : sunDiskIntensity },
        { type : float, name : sunGlowIntensity },
        { type : float, name : horizonSoftness },
        { type : float, name : gradientStrength },
        { type : float, name : horizonBandStrength },
        { type : float, name : sunGlowStrength },
        { type : float, name : minBrightness },
        { type : float, name : visualMode },
        { type : float, name : nightFactor },
        { type : float, name : dawnDuskFactor },
        { type : float, name : exposure }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float3 d = normalize(getWorldPosition().xyz - materialParams.skyCenter);

        float up = smoothstep(0.20, 0.85, d.y);
        float down = smoothstep(0.20, 0.85, -d.y);
        float horizon = 1.0 - smoothstep(0.00, 0.22, abs(d.y));

        float3 topColor = float3(1.0, 0.05, 0.20);
        float3 horizonColor = float3(0.10, 1.0, 0.10);
        float3 bottomColor = float3(0.05, 0.15, 1.0);

        float3 color = mix(bottomColor, horizonColor, 1.0 - down);
        color = mix(color, topColor, up);
        color = mix(color, horizonColor, horizon);

        float sunAlign = clamp(dot(d, normalize(-materialParams.sunDirection)), 0.0, 1.0);
        color += float3(1.0, 0.85, 0.45) * pow(sunAlign, 64.0) * 2.5;
        color += float3(1.0, 0.55, 0.20) * pow(sunAlign, 8.0) * 0.45;

        material.baseColor = float4(color, 1.0);
    }
}
