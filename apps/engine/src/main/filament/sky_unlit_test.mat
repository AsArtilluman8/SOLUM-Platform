material {
    name : sky_unlit_test,
    shadingModel : unlit,
    depthWrite : false,
    depthCulling : false,
    doubleSided : true,
    parameters : [
        {
            type : float4,
            name : baseColor
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.baseColor;
    }
}
