// SOLUM P63 recovery weather / lighting revision of the P63.3 analytic sky pipeline.
// Independently adapted from the Apache-2.0 Filament simulated sky structure at
// google/filament@579991668ebeadceece05d79b62f21964028553f.
// Water reflection and dynamic IBL are intentionally excluded.
material {
    name : SolumP63_4AnalyticSky,
    parameters : [
        { type : float3, name : sunDirection, precision : high },
        { type : float3, name : moonDirection, precision : high },
        { type : float3, name : moonToSunDirection, precision : high },
        { type : float4, name : atmosphere0, precision : high },
        { type : float4, name : atmosphere1, precision : high },
        { type : float4, name : atmosphereArt, precision : high },
        { type : float3, name : skyArtTint, precision : high },
        { type : float4, name : sun0, precision : high },
        { type : float4, name : sun1, precision : high },
        { type : float3, name : sunTint, precision : high },
        { type : float, name : sunEmissiveGain, precision : high },
        { type : float, name : sunDiscVisibility, precision : high },
        { type : float, name : sunExactValues, precision : high },
        { type : float4, name : moon0, precision : high },
        { type : float4, name : moon1, precision : high },
        { type : float3, name : moonTint, precision : high },
        { type : float4, name : stars0, precision : high },
        { type : float4, name : stars1, precision : high },
        { type : float3, name : starTint, precision : high },
        { type : float, name : siderealRotation, precision : high },
        { type : float4, name : cloud0, precision : high },
        { type : float4, name : cloud1, precision : high },
        { type : float4, name : cloud2, precision : high },
        { type : float4, name : cloud3, precision : high },
        { type : float4, name : celestialLight, precision : high },
        { type : float4, name : weather0, precision : high },
        { type : float3, name : cloudArtTint, precision : high },
        { type : float4, name : aurora0, precision : high },
        { type : float4, name : aurora1, precision : high },
        { type : float3, name : auroraColor, precision : high },
        { type : float, name : elapsedSeconds, precision : high },
        { type : float, name : starTextureAvailable, precision : high },
        { type : float, name : cloudTextureAvailable, precision : high },
        { type : sampler2d, name : moonAlbedo },
        { type : sampler2d, name : moonNormal },
        { type : sampler2d, name : tilingStars },
        { type : sampler2d, name : starsNoise },
        { type : sampler3d, name : cloudFormationVolume },
        { type : sampler3d, name : cloudErosionVolume },
        { type : sampler2d, name : cloudProfile },
        { type : sampler2d, name : auroraShape }
    ],
    variables : [
        { name : "eyeDirection", precision : "high" }
    ],
    vertexDomain : device,
    depthWrite : false,
    shadingModel : unlit,
    culling : none
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        highp vec4 p = getPosition();
        p.z = p.z * -0.5 + 0.5;
        highp vec4 worldPosition = getWorldFromClipMatrix() * p;
        material.eyeDirection.xyz = worldPosition.xyz;
    }
}

fragment {
    #define P63_PI 3.141592653589793

    highp float safePow(highp float value, highp float exponent) {
        return pow(max(value, 1.0e-6), exponent);
    }

    highp float airMass(highp float elevationSin) {
        highp float y = clamp(elevationSin, 0.001, 1.0);
        highp float zenithDegrees = acos(y) * (180.0 / P63_PI);
        return min(38.0, 1.0 / (y + 0.15 * safePow(93.885 - zenithDegrees, -1.253)));
    }

    highp float rayleighPhase(highp float cosine) {
        return 0.1875 * (1.0 + cosine * cosine);
    }

    highp float hgPhase(highp float cosine, highp float g) {
        highp float g2 = g * g;
        highp float denominator = safePow(1.0 + g2 - 2.0 * g * cosine, 1.5);
        return 0.25 * (1.0 - g2) / max(denominator, 1.0e-5);
    }

    highp vec3 bodyTransmittance(highp vec3 direction, highp vec3 extinction) {
        highp float refractedElevation = max(0.001, direction.y + 0.018);
        highp vec3 value = exp(-extinction * airMass(refractedElevation));
        highp float horizonVisibility = smoothstep(-0.075, 0.012, direction.y);
        return value * horizonVisibility;
    }

    highp vec3 analyticAtmosphere(highp vec3 viewDirection, highp vec3 lightDirection,
                                  out highp vec3 viewTransmittance,
                                  out highp vec3 sunTransmittance) {
        highp float turbidity = materialParams.atmosphere0.x;
        highp float rayleighScale = materialParams.atmosphere0.y;
        highp float mieScale = materialParams.atmosphere0.z;
        highp float mieG = materialParams.atmosphere0.w;
        highp float ozoneScale = materialParams.atmosphere1.x;
        highp float horizonHaze = materialParams.atmosphere1.y;
        highp float nightFloor = materialParams.atmosphere1.z;
        highp float horizonWarmth = materialParams.atmosphere1.w;

        highp vec3 betaR = vec3(0.0058, 0.0135, 0.0331) * rayleighScale;
        highp vec3 betaM = vec3(0.0085) * mieScale * (0.45 + turbidity * 0.22);
        highp vec3 betaO = vec3(0.0032, 0.0075, 0.0013) * ozoneScale;
        highp vec3 extinction = max(vec3(1.0e-5), betaR + betaM + betaO);
        // The sky draw is a background, not height fog. Keep the optical path finite below the
        // geometric horizon, then blend to a restrained lower-hemisphere fill. This avoids the
        // near-black "sandwich" seen around the diagnostic landscape without tinting scene meshes.
        highp float viewPath = airMass(max(0.012, viewDirection.y));
        viewTransmittance = exp(-extinction * viewPath);
        sunTransmittance = bodyTransmittance(lightDirection, extinction);

        highp float cosine = dot(viewDirection, lightDirection);
        highp float rPhase = rayleighPhase(cosine);
        highp float mPhase = hgPhase(cosine, mieG);
        highp vec3 scattering = (betaR * rPhase + betaM * mPhase) / extinction;
        highp float twilight = smoothstep(-0.20, 0.070, lightDirection.y);
        highp float day = smoothstep(-0.070, 0.18, lightDirection.y);
        highp vec3 incident = max(sunTransmittance, vec3(0.003 * twilight));
        highp vec3 color = scattering * (1.0 - viewTransmittance) * incident * (2.1 + day * 1.4);

        highp float horizon = safePow(1.0 - clamp(viewDirection.y, 0.0, 1.0), 4.0);
        highp vec3 longPathColor = normalize(max(sunTransmittance, vec3(1.0e-5)));
        color += longPathColor * horizon * horizonHaze * twilight * 0.16;
        color *= mix(vec3(1.0), vec3(1.0 + horizonWarmth * 0.15, 1.0, 1.0 - horizonWarmth * 0.12),
                     horizon * (1.0 - day));

        highp float night = 1.0 - smoothstep(-0.22, 0.045, lightDirection.y);
        color += vec3(0.18, 0.27, 0.48) * nightFloor * night;
        highp vec3 lowerNight = vec3(0.0015, 0.0025, 0.0045)
            + vec3(0.065, 0.11, 0.20) * nightFloor;
        highp vec3 lowerDay = mix(vec3(0.012, 0.017, 0.023),
            max(color * 0.26, vec3(0.022, 0.030, 0.038)), day);
        highp vec3 lowerHemisphere = mix(lowerNight, lowerDay, day);
        lowerHemisphere += longPathColor * horizonHaze * twilight * 0.008;
        // Keep the horizon transition narrow. The old broad -0.16..0.025 blend occupied a large
        // part of a portrait frame and looked like opaque height fog over the diagnostic stage.
        highp float horizonBlend = smoothstep(-0.045, 0.018, viewDirection.y);
        return mix(lowerHemisphere, color, horizonBlend);
    }

    highp vec3 applyAtmosphereArt(highp vec3 color, highp vec3 lightDirection) {
        highp float twilight = 1.0 - smoothstep(0.015, 0.36, abs(lightDirection.y));
        highp float gray = dot(color, vec3(0.2126, 0.7152, 0.0722));
        highp vec3 saturated = mix(vec3(gray), color, materialParams.atmosphereArt.x);
        highp vec3 contrasted = pow(max(saturated, vec3(1.0e-6)), vec3(materialParams.atmosphereArt.y));
        return mix(color, contrasted, twilight) * materialParams.skyArtTint;
    }

    highp float angularDiskMask(highp vec3 viewDirection, highp vec3 bodyDirection,
                                highp float angularRadius) {
        highp float distance = 1.0 - dot(viewDirection, bodyDirection);
        highp float radius = max(1.0e-7, 1.0 - cos(angularRadius));
        highp float aa = max(fwidth(distance) * 1.5, radius * 0.025);
        return 1.0 - smoothstep(radius - aa, radius + aa, distance);
    }

    highp float safeVisualLuminance(highp float nits, highp float exposureWeight) {
        return min(32.0, log2(1.0 + max(0.0, nits)) * 0.52 * exposureWeight);
    }

    highp float safeSunMaterialBrightness(highp float baseLuminance, highp float gain) {
        // The UI may request very large finite emissive gains, but the scene-linear signal gets
        // a monotonic shoulder before the global 64 HDR guard. This keeps >2x useful without
        // allowing a single numeric entry to turn the whole framebuffer white.
        highp float raw = max(0.0, baseLuminance) * clamp(gain, 0.0, 10000.0);
        return 64.0 * (1.0 - exp(-raw * (1.0 / 64.0)));
    }

    highp vec3 analyticSun(highp vec3 viewDirection, highp vec3 lightDirection,
                           highp vec3 transmittance, highp float cloudOpacity) {
        if (materialParams.sun0.w < 0.5) return vec3(0.0);
        if (materialParams.sunExactValues < 0.5 && lightDirection.y < -0.08) return vec3(0.0);
        highp float angularRadius = materialParams.sun0.x;
        highp float angularDistance = acos(clamp(dot(viewDirection, lightDirection), -1.0, 1.0));
        highp float relative = clamp(angularDistance / max(1.0e-7, angularRadius), 0.0, 1.0);
        // Exact UDS Sun_Disk topology: acos(dot) / radius -> saturate -> one-minus -> power.
        // The persisted control previously named limb darkening is mapped so its established
        // 0.55 default resolves to the exact Ultra_Dynamic_Sky CDO Sun Softness value of 3.8.
        highp float udsSoftness = materialParams.sunExactValues > 0.5
            ? clamp(materialParams.sun0.z, 0.5, 8.0)
            : max(0.25, materialParams.sun0.z * (3.8 / 0.55));
        highp float disk = safePow(1.0 - relative, udsSoftness);
        // The UDS material also gates the result to the forward hemisphere. The analytic sky
        // performs the horizon test above; this guard prevents a back-facing numerical remnant.
        disk *= clamp(dot(viewDirection, lightDirection) * 100.0, 0.0, 1.0);
        highp float discVisibility = clamp(materialParams.sunDiscVisibility, 0.0, 1.0);
        if (materialParams.sunExactValues > 0.5) {
            // Current Sun Disk Color already contains UDS curve color, disk/light intensity,
            // directional balance, eclipse edge, light color and disk tint. Cloud opacity is the
            // translated Composite Cloud Layers hard-alpha boundary.
            return materialParams.sunTint * disk * discVisibility * (1.0 - cloudOpacity);
        }
        // Legacy fallback: disc/material energy remains independent from directional-light lux.
        highp float luminance = safeSunMaterialBrightness(
            safeVisualLuminance(materialParams.sun0.y, materialParams.sun1.w),
            materialParams.sunEmissiveGain);
        // Bloom contribution raises only the finite HDR source. Filament bloom/lens starburst then
        // derives its response from the rendered source; no painted radial halo or ring is added.
        luminance *= 1.0 + clamp(materialParams.sun1.z, 0.0, 32.0) * 0.12;
        highp vec3 core = materialParams.sunTint * transmittance * luminance * disk
            * discVisibility;
        return core * (1.0 - cloudOpacity * 0.94);
    }

    highp vec2 rotateStarUv(highp vec2 uv, highp float turns) {
        highp float angle = turns * (2.0 * P63_PI);
        highp float sine = sin(angle);
        highp float cosine = cos(angle);
        return mat2(cosine, -sine, sine, cosine) * uv;
    }

    // Exact mobile translation of UDS Tiling_Stars_UVs:
    // WorldPosition-ActorPosition -> normalize -> +/-Z arccos radial projection,
    // Stars_Tiling=3, radial scale=.35, mirrored top X, opposite Sun Angle rotation,
    // and the signed .01 * (Stars Speed * Time + Stars Phase) drift.
    // UE uses Z-up; this renderer maps that axis to Filament's Y-up direction.
    void udsTilingStarUvs(highp vec3 direction, out highp vec2 topUv, out highp vec2 bottomUv) {
        highp vec2 horizontal = direction.xz;
        highp float horizontalLength = max(length(horizontal), 1.0e-5);
        highp vec2 radial = horizontal / horizontalLength;
        highp float topRadius = acos(clamp(direction.y, -1.0, 1.0)) * 0.35;
        highp float bottomRadius = acos(clamp(-direction.y, -1.0, 1.0)) * 0.35;
        highp float rotation = materialParams.siderealRotation / 360.0;
        highp float drift = (0.15 * materialParams.elapsedSeconds + 0.15) * 0.01;
        topUv = rotateStarUv(vec2(-radial.x, radial.y) * topRadius * 3.0, rotation)
            + vec2(0.0, drift);
        bottomUv = rotateStarUv(radial * bottomRadius * 3.0, -rotation)
            - vec2(0.0, drift);
    }

    highp vec3 analyticStars(highp vec3 viewDirection, highp vec3 lightDirection,
                             highp float cloudOpacity, highp float moonMask) {
        if (materialParams.stars1.w < 0.5 || materialParams.stars0.x <= 0.0
                || materialParams.starTextureAvailable < 0.5) return vec3(0.0);
        highp float night = 1.0 - smoothstep(-0.20, 0.070, lightDirection.y);
        night *= night;
        if (night <= 0.0) return vec3(0.0);

        highp vec2 topUv;
        highp vec2 bottomUv;
        udsTilingStarUvs(viewDirection, topUv, bottomUv);
        highp float hemisphere = smoothstep(-0.015, 0.015, viewDirection.y);
        highp vec3 source = mix(
            texture(materialParams_tilingStars, bottomUv).rgb,
            texture(materialParams_tilingStars, topUv).rgb,
            hemisphere);
        highp vec2 noiseUv = mix(bottomUv, topUv, hemisphere) * 2.0
            + vec2(materialParams.elapsedSeconds * 0.025, 0.0);
        highp float udsNoise = texture(materialParams_starsNoise, noiseUv).g;
        highp float twinkle = mix(1.0, mix(0.72, 1.28, udsNoise),
            clamp(materialParams.stars1.x, 0.0, 1.0));
        highp float limitingMagnitude = mix(0.72, 1.24,
            clamp(materialParams.stars0.z / 8.0, 0.0, 1.0));
        highp vec3 stars = clamp(source * materialParams.starTint * materialParams.stars0.x
            * materialParams.stars0.y * limitingMagnitude * twinkle, vec3(0.0), vec3(8.0));
        highp float skyHemisphere = smoothstep(0.005, 0.055, viewDirection.y);
        highp float cloudOcclusion = 1.0 - smoothstep(0.06, 0.92, cloudOpacity);
        return stars * night * skyHemisphere * cloudOcclusion * (1.0 - moonMask);
    }

    highp vec3 analyticMoon(highp vec3 viewDirection, highp vec3 moonDirection,
                            highp vec3 moonToSun, highp vec3 atmosphericTransmittance,
                            highp float cloudOpacity, out highp float moonMask) {
        moonMask = 0.0;
        if (materialParams.moon0.w < 0.5 || moonDirection.y < -0.08) return vec3(0.0);
        highp float angularRadius = materialParams.moon0.x;
        moonMask = angularDiskMask(viewDirection, moonDirection, angularRadius);
        highp float cosine = dot(viewDirection, moonDirection);
        highp vec3 tangent = viewDirection - cosine * moonDirection;
        highp float sinRadius = max(1.0e-7, sin(angularRadius));
        highp vec3 normalPerpendicular = tangent / sinRadius;
        highp float perpendicularSquared = dot(normalPerpendicular, normalPerpendicular);
        highp vec3 sphereNormal = normalize(normalPerpendicular
            - moonDirection * sqrt(max(0.0, 1.0 - perpendicularSquared)));

        highp vec3 up = abs(moonDirection.y) > 0.98 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        highp vec3 right = normalize(cross(up, moonDirection));
        highp vec3 moonUp = cross(moonDirection, right);
        highp vec2 uv = vec2(dot(sphereNormal, right), dot(sphereNormal, moonUp)) * 0.5 + 0.5;
        uv = vec2(1.0 - uv.x, 1.0 - uv.y);
        highp vec3 albedo = texture(materialParams_moonAlbedo, uv).rgb;
        // Exact UDS Moon graph appends PhaseNormal R+B, then G: the authored vector is R,B,G.
        highp vec3 detail = texture(materialParams_moonNormal, uv).xzy * 2.0 - 1.0;
        detail.xy *= materialParams.moon1.x;
        detail.x *= -1.0;
        detail.z = sqrt(max(0.02, 1.0 - min(0.98, dot(detail.xy, detail.xy))));
        highp vec3 perturbed = normalize(detail.x * right + detail.y * moonUp + detail.z * sphereNormal);

        // UDS exposes phase angle, normal and terminator sharpness as separate semantics. Keep the
        // large-scale geometric phase independent from crater detail: the normal map may shade the
        // lit hemisphere, but can never bend or fragment the terminator.
        highp float geometricNdotL = dot(sphereNormal, moonToSun);
        highp float terminatorWidth = max(fwidth(geometricNdotL) * 1.65, 0.010);
        highp float terminator = smoothstep(-terminatorWidth, terminatorWidth, geometricNdotL);
        highp float craterNdotL = max(0.0, dot(perturbed, moonToSun));
        highp float craterRelief = clamp(0.76 + craterNdotL * 0.46, 0.76, 1.20);
        // Exact UDS CDO Moon Phase Contrast is 1.6. It shapes the large terminator only; crater
        // normals remain a detail multiplier and therefore cannot fragment the lunar phase.
        highp float direct = safePow(max(0.0, geometricNdotL), 1.6)
            * terminator * craterRelief;
        highp float earthPhase = clamp(0.5 * (1.0 + dot(moonToSun, moonDirection)), 0.0, 1.0);
        highp float earthFacing = max(0.0, dot(sphereNormal, -moonDirection));
        // Preserve the user-facing control while mapping its established 0.018 default to the
        // exact Ultra_Dynamic_Sky CDO Dark Side Brightness value of 0.005.
        // Earthshine affects only the unlit hemisphere and never contributes to the Moon halo.
        highp float earthshineStrength = min(0.05,
            materialParams.moon0.z * (0.005 / 0.018));
        highp float earthshine = earthshineStrength * earthPhase
            * safePow(earthFacing, 0.72) * (1.0 - terminator);
        highp float luminance = safeVisualLuminance(materialParams.moon0.y, 0.58);
        // Exact Ultra_Dynamic_Sky CDO Moon Texture Intensity: 0.3 at night and 0.6 by day.
        highp float moonTextureIntensity = mix(0.3, 0.6,
            smoothstep(-0.08, 0.10, materialParams.sunDirection.y));
        highp vec3 disk = albedo * materialParams.moonTint * atmosphericTransmittance
            * luminance * moonTextureIntensity * (direct + earthshine) * moonMask;

        // Exact UDS Moon glow topology: tangent length / Glow Scale -> saturate -> one-minus,
        // squared, then multiplied by Glow Intensity. CDO Glow Scale is 1.0 and intensity 0.05.
        // This is one monotonic aureole over the Moon-facing hemisphere, not nested radial rings.
        highp float moonFacing = step(0.0, dot(viewDirection, moonDirection));
        highp float tangentLength = length(viewDirection
            - dot(viewDirection, moonDirection) * moonDirection);
        highp float glowAlpha = 1.0 - clamp(tangentLength, 0.0, 1.0);
        glowAlpha *= glowAlpha * moonFacing;
        highp float illuminatedFraction = clamp(0.5 * (1.0 - dot(moonToSun, moonDirection)), 0.0, 1.0);
        highp float haloPhase = sqrt(illuminatedFraction);
        highp vec3 glow = materialParams.moonTint * atmosphericTransmittance
            * luminance * moonTextureIntensity * glowAlpha * haloPhase * materialParams.moon1.y;
        return (disk + glow) * (1.0 - cloudOpacity * 0.96);
    }

    highp vec2 mirrorRepeat(highp vec2 uv) {
        highp vec2 wrapped = mod(uv, 2.0);
        return 1.0 - abs(wrapped - 1.0);
    }

    highp vec3 analyticAurora(highp vec3 viewDirection, highp vec3 lightDirection) {
        if (materialParams.aurora0.x < 0.5 || materialParams.aurora1.w < 0.5
                || viewDirection.y <= 0.0) return vec3(0.0);
        highp float night = 1.0 - smoothstep(-0.22, -0.035, lightDirection.y);
        if (night <= 0.0) return vec3(0.0);
        highp float time = materialParams.elapsedSeconds;
        highp float scale = materialParams.aurora0.z;
        highp float azimuth = atan(viewDirection.z, viewDirection.x);
        // Integer azimuth harmonics are periodic at -PI/+PI. Texture coordinates use the
        // continuous XZ direction plane, so no equirectangular seam can enter the two UDS panners.
        highp float waveA = sin(azimuth * 6.0 + time * materialParams.aurora0.w * 0.68);
        highp float waveB = sin(azimuth * 11.0 - time * materialParams.aurora1.x * 0.46 + waveA);
        highp vec2 directionPlane = viewDirection.xz * 0.5 + 0.5;
        highp vec2 curtainPlane = directionPlane
            + normalize(viewDirection.xz + vec2(1.0e-5)) * (waveA * 0.018 + waveB * 0.011);
        highp vec2 uv1 = curtainPlane * vec2(scale * 0.88, scale * 0.72)
            + vec2(time * materialParams.aurora0.w * 0.0062, waveB * 0.035);
        highp vec2 uv2 = curtainPlane.yx * vec2(scale * 1.31, scale * 0.91)
            + vec2(-time * materialParams.aurora0.w * 0.0047 + 0.23,
                   time * materialParams.aurora1.x * 0.0031 + waveA * 0.026);
        // UDS Aurora material evidence explicitly samples the ParticleClouds green channel twice
        // and derives shape from one minus their absolute difference. This is the bounded mobile
        // adaptation; the UE volume loop is deliberately not copied.
        highp float sample1 = texture(materialParams_auroraShape, mirrorRepeat(uv1)).g;
        highp float sample2 = texture(materialParams_auroraShape, mirrorRepeat(uv2)).g;
        highp float shape = 1.0 - abs(sample1 - sample2);
        shape = safePow(clamp(shape, 0.0, 1.0), materialParams.aurora1.y);
        highp float lower = smoothstep(0.015, 0.10, viewDirection.y);
        highp float upper = 1.0 - smoothstep(materialParams.aurora1.z, min(0.98, materialParams.aurora1.z + 0.34), viewDirection.y);
        highp float curtain = shape * lower * upper;
        highp float fineFold = 0.72 + 0.28
            * sin(azimuth * 18.0 + sample1 * 19.0 + time * materialParams.aurora0.w * 0.7);
        highp vec3 color = materialParams.auroraColor * curtain * fineFold
            * materialParams.aurora0.y * night;
        color += mix(materialParams.auroraColor, vec3(0.24, 0.42, 1.0), 0.46)
            * safePow(curtain, 2.2) * materialParams.aurora0.y * 0.38 * night;
        return max(color, vec3(0.0));
    }

    highp float raySphere(highp vec3 direction, highp float radius, highp float height) {
        highp float shellRadius = radius + height;
        highp float b = radius * direction.y;
        highp float c = radius * radius - shellRadius * shellRadius;
        highp float discriminant = b * b - c;
        return discriminant < 0.0 ? -1.0 : -b + sqrt(discriminant);
    }

    // Mobile translation of the verified UDS Conservative_Density and
    // Volumetric_Clouds_Extinction graphs. FormationVolume supplies the authored large masses;
    // 3D_Cells_32 is sampled separately for erosion and high-frequency breakup.
    highp float udsCloudDensity(highp vec3 localPosition, highp float normalizedHeight,
                                highp float opticalThickness, highp float coverageScale,
                                highp float cirrus, highp float quality) {
        highp float time = materialParams.elapsedSeconds;
        highp vec2 windDirection = vec2(cos(materialParams.cloud3.y),
                                        sin(materialParams.cloud3.y));
        // Current Base Clouds Scale = Formation Texture Scale * 1,200,000 cm * Volume Scale.
        // Both CDO scales are 1, therefore one authored FormationVolume tile spans 12 km.
        highp vec2 formationUv = localPosition.xz / 12.0;
        formationUv += windDirection * time * materialParams.cloud1.w * 0.02;
        // Conservative Density uses (Clouds B Time * Formation Change Speed) / 100.
        highp float formationTime = time * materialParams.cloud2.x * 0.01;
        highp vec3 formationRgb = texture(materialParams_cloudFormationVolume,
            fract(vec3(formationUv, formationTime))).rgb;

        // Get Cloud Coverage 0-3 and Current Volumetric Clouds Density, including the exact
        // low-coverage correction used by the UDS Blueprint.
        highp float coverage03 = clamp(materialParams.cloud0.x * coverageScale, 0.0, 1.0) * 3.0;
        highp float lowCoverageCorrection = mix(0.2, 0.0,
            clamp(coverage03 / 0.2, 0.0, 1.0));
        highp float finalDensity = clamp((coverage03 - lowCoverageCorrection) * 1.15, -0.2, 3.0);
        highp vec2 macroPhase = fract(formationUv / 1.3) * (2.0 * P63_PI);
        finalDensity = clamp(finalDensity
            + sin(macroPhase.x) * sin(macroPhase.y) * 0.16, -0.2, 3.0);
        highp float coverageThreshold = safePow(1.0 - finalDensity / 6.5, 3.0) - 0.25;
        highp float taperedCoverage = clamp(formationRgb.r - coverageThreshold, 0.0, 1.0)
            / max(0.001, 1.0 - coverageThreshold);

        highp float floorVariationBase = mix(0.1, 0.8,
            clamp(finalDensity - 1.5, 0.0, 1.0));
        highp float floorVariation = clamp(normalizedHeight
            * (1.0 + formationRgb.b * formationRgb.b * floorVariationBase), 0.0, 1.0);
        highp vec3 profile = texture(materialParams_cloudProfile,
            vec2(clamp(finalDensity / 3.0, 0.0, 1.0), 1.0 - floorVariation)).rgb;
        highp float conservativeShape = clamp(taperedCoverage - (1.0 - profile.r), 0.0, 1.0);

        // Exact high sub-noise scale at the UDS defaults is 1.2 x 1.2 x .696 km.
        // It receives the same world translation as FormationVolume, hence the tenfold UV pan.
        highp vec2 erosionPan = windDirection * time * materialParams.cloud1.w * 0.2;
        highp vec3 erosionUv = vec3(localPosition.x / 1.2 + erosionPan.x,
            localPosition.z / 1.2 + erosionPan.y,
            normalizedHeight * opticalThickness / 0.696);
        highp vec3 erosionRgb = texture(materialParams_cloudErosionVolume, fract(erosionUv)).rgb;
        // Exact UDS MPC defaults: Erosion Power=3, Minimum Erosion=0, Extinction Scale=10.
        highp float erosion = safePow(erosionRgb.r, 3.0)
            * materialParams.cloud1.z * max(profile.b, 0.0);
        highp float shape = conservativeShape - erosion;

        // Exact UDS custom-node structure: Result=.5, sample R-.55, strength*=.6, UVW*=2.
        highp float highFrequency = 0.5;
        highp float hfStrength = 1.0;
        if (quality > 0.5) {
            highFrequency += (texture(materialParams_cloudErosionVolume,
                fract(erosionUv * 2.0 + erosionRgb)).r - 0.55) * hfStrength;
            hfStrength *= 0.6;
        }
        if (quality > 1.5) {
            highFrequency += (texture(materialParams_cloudErosionVolume,
                fract(erosionUv * 4.0 + erosionRgb)).r - 0.55) * hfStrength;
        }
        shape += (highFrequency - 0.55)
            * 0.2 * erosionRgb.b;

        // Softness is a bounded author control over the edge of the exact UDS density field;
        // it does not generate or substitute cloud structure.
        highp float edgeShape = mix(max(shape, 0.0),
            smoothstep(0.0, 0.18, max(shape, 0.0)) * max(shape, 0.0),
            materialParams.cloud0.z);
        highp float extinction = edgeShape
            * safePow(profile.g, 3.0) * 10.0 * materialParams.cloud0.y;
        extinction *= mix(1.0, 0.52, cirrus);
        return clamp(extinction, 0.0, 1.0);
    }

    highp vec4 cloudShellLayer(highp vec3 viewDirection, highp vec3 lightDirection,
                               highp vec3 moonDirection,
                               highp vec3 skyAmbient, highp vec3 sunTransmittance,
                               highp float height, highp float coverageScale,
                               highp float cirrus) {
        highp float enabled = materialParams.cloud0.w;
        if (enabled < 0.5 || materialParams.cloudTextureAvailable < 0.5
            || materialParams.cloud0.x <= 0.0 || viewDirection.y < 0.0) return vec4(0.0);
        highp float planetRadius = 6371.0;
        highp float baseDistance = raySphere(viewDirection, planetRadius, height);
        highp float topDistance = raySphere(viewDirection, planetRadius,
            height + max(0.01, materialParams.cloud1.y * mix(1.0, 0.45, cirrus)));
        if (baseDistance <= 0.0 || topDistance <= baseDistance) return vec4(0.0);
        highp float shellDepth = topDistance - baseDistance;
        highp float quality = materialParams.cloud2.w;
        highp float opticalThickness = materialParams.cloud1.y * mix(1.0, 0.35, cirrus);
        // True finite-shell volume integration. Quality tiers use 5/8/12 primary observations;
        // every observation evaluates the exact UDS formation/profile extinction function.
        highp float sampleCount = quality > 1.5 ? 12.0 : (quality > 0.5 ? 8.0 : 5.0);
        highp float viewStep = shellDepth / sampleCount;
        highp float opticalStep = min(viewStep, max(0.06, opticalThickness * 0.42));
        highp vec3 planetCenter = vec3(0.0, planetRadius, 0.0);
        highp float viewTransmittanceCloud = 1.0;
        highp float integratedDensity = 0.0;
        highp float lightDensity = 0.0;
        for (int sampleIndex = 0; sampleIndex < 12; ++sampleIndex) {
            if (float(sampleIndex) >= sampleCount) break;
            highp float sampleDistance = baseDistance
                + (float(sampleIndex) + 0.5) * viewStep;
            highp vec3 localPosition = viewDirection * sampleDistance;
            highp float normalizedHeight = clamp(
                (length(planetCenter + localPosition) - planetRadius - height)
                    / max(0.01, opticalThickness), 0.0, 1.0);
            highp float sampleDensity = udsCloudDensity(localPosition, normalizedHeight,
                opticalThickness, coverageScale, cirrus, quality);
            integratedDensity += sampleDensity / sampleCount;
            if (sampleDensity > 0.002) {
                highp vec3 lightProbePosition = localPosition + lightDirection
                    * max(0.35, opticalThickness * 0.28);
                highp float lightProbeHeight = clamp(normalizedHeight
                    + lightDirection.y * 0.18, 0.0, 1.0);
                lightDensity += udsCloudDensity(lightProbePosition, lightProbeHeight,
                    opticalThickness, coverageScale, cirrus, 0.0) / sampleCount;
                viewTransmittanceCloud *= exp(-sampleDensity * opticalStep
                    * (0.78 + opticalThickness * 0.34));
            }
            if (viewTransmittanceCloud < 0.012) break;
        }
        integratedDensity = clamp(max(integratedDensity,
            (1.0 - viewTransmittanceCloud) * 0.42), 0.0, 1.0);
        lightDensity = clamp(lightDensity, 0.0, 1.0);
        highp float opacity = clamp(1.0 - viewTransmittanceCloud, 0.0, 0.985);

        highp float cosine = dot(viewDirection, lightDirection);
        highp float edgeDensity = safePow(1.0 - integratedDensity, 1.6);
        highp float silver = hgPhase(cosine, 0.88) * materialParams.cloud2.y * edgeDensity * 0.42;
        highp float beer = exp(-(integratedDensity + lightDensity * 0.72)
            * (1.75 + opticalThickness * 1.25));
        highp float sunStrength = 1.0 - exp(-max(0.0, materialParams.celestialLight.x) * 0.055);
        highp float moonStrength = 1.0 - exp(-max(0.0, materialParams.celestialLight.y) * 4.5);
        highp float darkestCore = mix(0.86, 0.64, materialParams.cloud3.z);
        highp float coreDarkening = mix(0.96, darkestCore,
            clamp(integratedDensity * (0.72 + opticalThickness * 0.18), 0.0, 1.0));
        highp float powder = 1.0 - exp(-integratedDensity * 2.4);
        highp float twilightColor = 1.0 - smoothstep(0.03, 0.32, abs(lightDirection.y));
        highp vec3 sunsetChroma = normalize(max(sunTransmittance, vec3(1.0e-5)));
        highp vec3 transmittedSun = mix(sunTransmittance,
            sunsetChroma * (0.28 + twilightColor * 0.72), twilightColor * 0.72) * sunStrength
            * (beer * 0.58 + silver * 0.92 + powder * coreDarkening * 0.16);
        highp float moonCosine = dot(viewDirection, moonDirection);
        highp float moonForward = min(1.0, hgPhase(moonCosine, 0.82) * edgeDensity
            * materialParams.cloud2.y * 0.035);
        highp vec3 moonLight = materialParams.moonTint * moonStrength
            * (beer * 0.028 + moonForward * 0.12 + powder * coreDarkening * 0.012);
        // Filament's analytic example keeps a minimum ambient term so dense shells do not become
        // black holes. This bounded fill is still driven by sky, Sun/Moon and optical thickness;
        // it is not cloud emissive and cannot glow independently at night.
        highp float dayAmbient = smoothstep(-0.12, 0.10, lightDirection.y);
        highp vec3 ambientFloor = mix(vec3(0.0010, 0.0017, 0.0032),
            max(skyAmbient * 0.48, sunTransmittance * sunStrength * 0.050), dayAmbient);
        ambientFloor += materialParams.moonTint * moonStrength * 0.0018;
        highp vec3 ambient = max(skyAmbient * (0.48 + beer * 0.34) * coreDarkening,
            ambientFloor * (0.66 + beer * 0.34));
        highp vec3 lightning = vec3(0.62, 0.72, 1.0)
            * materialParams.weather0.w * (0.18 + integratedDensity * 0.82);
        highp vec3 precipitationTint = mix(vec3(1.0),
            vec3(0.82, 0.88, 0.98), materialParams.weather0.x * 0.20
                + materialParams.weather0.z * 0.16);
        precipitationTint = mix(precipitationTint, vec3(0.92, 0.97, 1.0),
            materialParams.weather0.y * 0.22);
        highp vec3 lighting = (ambient + transmittedSun + moonLight) * precipitationTint + lightning;
        // The LUT profile and Beer-Lambert integration already provide the cloud edge.
        // A second fwidth-based opacity gate used here previously reduced valid UDS
        // extinction by another two to three orders of magnitude on device.
        // No artificial horizon fade: the spherical shell itself determines whether a sunset
        // Sun/Moon ray crosses cloud. The below-horizon guard above still rejects ground rays.
        highp vec3 color = lighting * materialParams.cloud2.z * materialParams.cloudArtTint;
        return vec4(max(color, vec3(0.0)), clamp(opacity, 0.0, 0.96));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec3 viewDirection = normalize(variable_eyeDirection.xyz);
        highp vec3 lightDirection = normalize(materialParams.sunDirection);
        highp vec3 moonDirection = normalize(materialParams.moonDirection);
        highp vec3 moonToSun = normalize(materialParams.moonToSunDirection);

        highp vec3 viewTransmittance;
        highp vec3 sunTransmittance;
        highp vec3 color = analyticAtmosphere(viewDirection, lightDirection,
                                              viewTransmittance, sunTransmittance);
        color = applyAtmosphereArt(color, lightDirection);

        highp float cloudType = materialParams.cloud3.x;
        highp float cirrusSelected = step(1.5, cloudType) * (1.0 - step(2.5, cloudType));
        highp vec4 baseCloud = vec4(0.0);
        highp vec4 highCloud = vec4(0.0);
        if (cirrusSelected < 0.5) {
            baseCloud = cloudShellLayer(viewDirection, lightDirection, moonDirection, color,
                sunTransmittance, materialParams.cloud1.x, 1.0, 0.0);
        } else {
            highCloud = cloudShellLayer(viewDirection, lightDirection, moonDirection, color,
                sunTransmittance, materialParams.cloud1.x + 5.5, 0.62, 1.0);
        }
        highp float cloudOpacity = 1.0 - (1.0 - baseCloud.a) * (1.0 - highCloud.a);
        highp vec3 cloudColor = baseCloud.rgb;
        if (highCloud.a > 0.001) cloudColor = mix(cloudColor, highCloud.rgb,
            highCloud.a / max(0.001, baseCloud.a + highCloud.a));

        // Bounded sky-only crepuscular scattering: forward atmospheric scattering is revealed by
        // cloud transmittance and density edges. This is part of the analytic sky draw and is not
        // a screen overlay or a claim of depth-aware terrain volumetrics.
        if (materialParams.celestialLight.w > 0.001 && lightDirection.y > -0.02) {
            highp float forward = hgPhase(dot(viewDirection, lightDirection), 0.94);
            highp float cloudEdge = clamp(fwidth(cloudOpacity) * 22.0
                + 3.2 * cloudOpacity * (1.0 - cloudOpacity), 0.0, 1.0);
            highp float sunStrength = 1.0 - exp(-max(0.0, materialParams.celestialLight.x) * 0.055);
            highp float cloudTransmittance = 1.0 - cloudOpacity * materialParams.cloud3.z;
            color += materialParams.sunTint * sunTransmittance * sunStrength
                * forward * (cloudTransmittance * 0.045 + cloudEdge * 0.095)
                * materialParams.celestialLight.w;
        }
        if (materialParams.celestialLight.w > 0.001 && moonDirection.y > -0.035) {
            highp float moonForward = hgPhase(dot(viewDirection, moonDirection), 0.93);
            highp float cloudEdge = clamp(fwidth(cloudOpacity) * 18.0
                + 2.6 * cloudOpacity * (1.0 - cloudOpacity), 0.0, 1.0);
            highp float moonStrength = 1.0
                - exp(-max(0.0, materialParams.celestialLight.y) * 4.5);
            highp float cloudTransmittance = 1.0 - cloudOpacity * materialParams.cloud3.z;
            color += materialParams.moonTint * moonStrength * moonForward
                * (cloudTransmittance * 0.010 + cloudEdge * 0.030)
                * materialParams.celestialLight.w;
        }

        highp float moonMask = angularDiskMask(viewDirection, moonDirection, materialParams.moon0.x)
            * materialParams.moon0.w;
        color += analyticStars(viewDirection, lightDirection, cloudOpacity, moonMask);
        color += analyticAurora(viewDirection, lightDirection) * (1.0 - cloudOpacity * 0.92);
        color += analyticSun(viewDirection, lightDirection, sunTransmittance, cloudOpacity);
        highp float resolvedMoonMask;
        color += analyticMoon(viewDirection, moonDirection, moonToSun,
            bodyTransmittance(moonDirection,
                vec3(0.0058, 0.0135, 0.0331) * materialParams.atmosphere0.y
                + vec3(0.0085) * materialParams.atmosphere0.z
                + vec3(0.0032, 0.0075, 0.0013) * materialParams.atmosphere1.x),
            cloudOpacity, resolvedMoonMask);
        color = mix(color, cloudColor, cloudOpacity);

        // Exact UDS Current Sun Disk Color is intentionally HDR (hundreds at the CDO defaults).
        // Its finite, range-bounded CPU inputs must reach Filament tonemapping without the legacy
        // 64-unit shoulder clipping all three channels to white. Keep that guard only for the
        // user-selected legacy artistic path.
        color = max(color, vec3(0.0));
        if (materialParams.sunExactValues < 0.5) color = min(color, vec3(64.0));
        material.baseColor = vec4(color, 1.0);
    }
}
