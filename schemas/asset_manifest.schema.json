{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solum.asset_manifest.v1",
  "title": "SOLUM Asset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "assetId",
    "assetType",
    "displayName",
    "createdAt",
    "createdBy",
    "fileList",
    "contentHashes",
    "schemaCompatibleWith",
    "validationState"
  ],
  "properties": {
    "schema": {
      "const": "solum.asset"
    },
    "schemaVersion": {
      "const": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 8
    },
    "assetType": {
      "type": "string",
      "enum": [
        "texture",
        "mesh",
        "material",
        "character",
        "animation",
        "vfx",
        "scene",
        "sound",
        "video",
        "world",
        "mechanic",
        "diagnostic",
        "shader",
        "font",
        "ui",
        "prefab"
      ]
    },
    "assetSubType": {
      "type": "string",
      "minLength": 1,
      "description": "Precise type inside assetType, e.g. image_2d, static_mesh, skeletal_mesh, material_instance, music, cutscene_video."
    },
    "sourceFormat": {
      "type": "string",
      "minLength": 1,
      "description": "Original/source format, e.g. png, jpg, glb, wav, mp3, mp4, solum_material."
    },
    "runtimeFormat": {
      "type": "string",
      "minLength": 1,
      "description": "Runtime/processed format, e.g. ktx2_astc, solum_static_mesh, decoded_audio_runtime."
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 10
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "fileList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contentHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-fA-F0-9]{64}$"
      }
    },
    "schemaCompatibleWith": {
      "type": "string",
      "minLength": 1
    },
    "validationState": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "pending",
        "incompatible",
        "missing_file"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Small extensible metadata block for tool-specific non-critical info. Core fields must stay outside metadata."
    }
  }
}
