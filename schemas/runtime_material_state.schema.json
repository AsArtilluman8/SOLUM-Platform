{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solum.runtime_material_state.schema.json",
  "title": "SOLUM runtime material state",
  "type": "object",
  "required": ["schema", "schemaVersion", "status", "standard", "textureSlots"],
  "properties": {
    "schema": { "const": "solum.runtime_material_state" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "status": { "type": "string" },
    "standard": { "type": "string" },
    "importerDecision": { "type": "string" },
    "textureSlots": { "type": "object" },
    "forbiddenShortcuts": { "type": "array", "items": { "type": "string" } }
  }
}
