+class SolumGpuProfiler;
 
 /*
  * A concrete implementation of the Renderer Interface.
@@ -165,6 +166,9 @@ public:
         return MAX_FRAMETIME_HISTORY;
     }
 
+    bool startSolumGpuProfiler(uint32_t maxSampledFrames, uint32_t samplePeriod);
