diff --git a/filament/src/details/Renderer.cpp b/filament/src/details/Renderer.cpp
index ae2f67b8a0a9161dce3cdbf0b4f70fef94deffd4..a3ba1cf8fc29029661b2d9e0ec07533d5dacbbfa 100644
--- a/filament/src/details/Renderer.cpp
+++ b/filament/src/details/Renderer.cpp
@@ -68,11 +68,16 @@
 #include <utils/debug.h>
 
 #include <algorithm>
+#include <array>
+#include <cctype>
 #include <cmath>
 #include <chrono>
 #include <limits>
 #include <memory>
+#include <sstream>
+#include <string>
 #include <utility>
+#include <vector>
 
 #include <stddef.h>
 #include <stdint.h>
@@ -91,11 +96,394 @@ namespace filament {
 
 using namespace backend;
 
+class SolumGpuProfiler {
+    // VulkanQueryManager in v1.71.4 has 32 timer handles total. FrameInfo owns four.
+    // Keep a safety margin for other engine users and rotate a pass window across frames.
+    static constexpr size_t QUERY_COUNT = 20;
+    static constexpr size_t PASS_QUERY_BUDGET = 12;
+    static constexpr size_t RECORD_LIMIT = 8192;
+
+    struct Slot {
+        TimerQueryHandle handle{};
+        bool pending = false;
+        uint32_t frameId = 0;
+        uint32_t passOrdinal = UINT32_MAX;
+        std::string kind;
+        std::string view;
+        std::string pass;
+    };
+
+    struct Record {
+        uint32_t frameId;
+        uint64_t elapsedNs;
+        uint32_t passOrdinal;
+        std::string kind;
+        std::string view;
+        std::string pass;
+    };
+
+    struct Aggregate {
+        std::string owner;
+        uint64_t totalNs = 0;
+        uint64_t maxNs = 0;
+        uint32_t count = 0;
+    };
+
+public:
+    explicit SolumGpuProfiler(FEngine& engine) noexcept : mEngine(engine) {
+        mHooks.user = this;
+        mHooks.beginPass = [](void* user, DriverApi& driver, char const* name) noexcept {
+            static_cast<SolumGpuProfiler*>(user)->beginPass(driver, name);
+        };
+        mHooks.endPass = [](void* user, DriverApi& driver) noexcept {
+            static_cast<SolumGpuProfiler*>(user)->endPass(driver);
+        };
+    }
+
+    bool start(uint32_t maxSampledFrames, uint32_t samplePeriod) {
+        DriverApi& driver = mEngine.getDriverApi();
+        if (!initialize(driver)) {
+            return false;
+        }
+        poll(driver, QUERY_COUNT);
+        if (mOutstanding != 0) {
+            return false;
+        }
+        mRecords.clear();
+        mMaxSampledFrames = std::max(1u, maxSampledFrames);
+        mSamplePeriod = std::max(1u, samplePeriod);
+        mFrameOrdinal = 0;
+        mSampledFrames = 0;
+        mDroppedScopes = 0;
+        mErrorScopes = 0;
+        mObservedPasses = 0;
+        mUnsampledPasses = 0;
+        mNextPassWindowStart = 0;
+        mFrameToken = -1;
+        mViewToken = -1;
+        mPassToken = -1;
+        mCapturing = true;
+        mSampleFrame = false;
+        return true;
+    }
+
+    void terminate(DriverApi& driver) noexcept {
+        mCapturing = false;
+        for (Slot& slot : mSlots) {
+            if (slot.handle) {
+                driver.destroyTimerQuery(slot.handle);
+            }
+            slot = {};
+        }
+        mInitialized = false;
+        mSupported = false;
+        mOutstanding = 0;
+    }
+
+    void beginFrame(DriverApi& driver, uint32_t frameId) noexcept {
+        if (mInitialized) {
+            poll(driver, 128);
+        }
+        mCurrentFrameId = frameId;
+        mFrameOrdinal++;
+        mSampleFrame = mCapturing && mSampledFrames < mMaxSampledFrames &&
+                ((mFrameOrdinal - 1u) % mSamplePeriod == 0u);
+        if (!mSampleFrame) {
+            return;
+        }
+        mFramePassOrdinal = 0;
+        mPassWindowStart = mNextPassWindowStart;
+        mSampledFrames++;
+        mFrameToken = beginScope(driver, "frame", "SOLUM_AcceptedFrame", "");
+    }
+
+    void endFrame(DriverApi& driver) noexcept {
+        if (!mSampleFrame) {
+            return;
+        }
+        endScope(driver, mFrameToken);
+        mFrameToken = -1;
+        mObservedPasses += mFramePassOrdinal;
+        if (mFramePassOrdinal > 0) {
+            mNextPassWindowStart = uint32_t(
+                    (mPassWindowStart + PASS_QUERY_BUDGET) % mFramePassOrdinal);
+        }
+        mSampleFrame = false;
+    }
+
+    FrameGraph::ExecutionHooks const* beginView(DriverApi& driver,
+            char const* viewName) noexcept {
+        if (!mSampleFrame) {
+            return nullptr;
+        }
+        mCurrentView = viewName ? viewName : "UNNAMED_VIEW";
+        mViewToken = beginScope(driver, "view", mCurrentView.c_str(), "");
+        return &mHooks;
+    }
+
+    void endView(DriverApi& driver) noexcept {
+        endScope(driver, mViewToken);
+        mViewToken = -1;
+        mCurrentView.clear();
+    }
+
+    utils::CString stop() {
+        DriverApi& driver = mEngine.getDriverApi();
+        mCapturing = false;
+        if (mInitialized) {
+            poll(driver, QUERY_COUNT);
+        }
+
+        char const* status = "UNAVAILABLE";
+        if (!mRecords.empty()) {
+            status = mOutstanding == 0 ? "AVAILABLE" : "AVAILABLE_PARTIAL_PENDING";
+        } else if (mOutstanding != 0) {
+            status = "PENDING";
+        }
+
+        std::vector<Aggregate> aggregates;
+        for (Record const& record : mRecords) {
+            std::string owner = classify(record);
+            auto pos = std::find_if(aggregates.begin(), aggregates.end(),
+                    [&owner](Aggregate const& aggregate) { return aggregate.owner == owner; });
+            if (pos == aggregates.end()) {
+                aggregates.push_back({ std::move(owner), record.elapsedNs,
+                        record.elapsedNs, 1 });
+            } else {
+                pos->totalNs += record.elapsedNs;
+                pos->maxNs = std::max(pos->maxNs, record.elapsedNs);
+                pos->count++;
+            }
+        }
+
+        std::ostringstream out;
+        out << "{\"schema\":\"solum.filament_gpu_profiler/v1\",\"status\":\""
+            << status
+            << "\",\"source\":\"backend_timer_query_async\""
+            << ",\"scopeSemantics\":\"nested_not_additive\""
+            << ",\"queryHandleBudget\":" << QUERY_COUNT
+            << ",\"passWindowBudget\":" << PASS_QUERY_BUDGET
+            << ",\"samplePeriod\":" << mSamplePeriod
+            << ",\"sampledFrames\":" << mSampledFrames
+            << ",\"observedPasses\":" << mObservedPasses
+            << ",\"intentionallyUnsampledPasses\":" << mUnsampledPasses
+            << ",\"completedScopes\":" << mRecords.size()
+            << ",\"pendingScopes\":" << mOutstanding
+            << ",\"droppedScopes\":" << mDroppedScopes
+            << ",\"errorScopes\":" << mErrorScopes
+            << ",\"aggregates\":[";
+        bool first = true;
+        for (Aggregate const& aggregate : aggregates) {
+            if (!first) {
+                out << ',';
+            }
+            first = false;
+            out << "{\"owner\":\"" << escape(aggregate.owner)
+                << "\",\"count\":" << aggregate.count
+                << ",\"totalGpuNs\":" << aggregate.totalNs
+                << ",\"maxGpuNs\":" << aggregate.maxNs << '}';
+        }
+        out << "],\"records\":[";
+        first = true;
+        for (Record const& record : mRecords) {
+            if (!first) {
+                out << ',';
+            }
+            first = false;
+            out << "{\"frameId\":" << record.frameId
+                << ",\"kind\":\"" << escape(record.kind)
+                << "\",\"owner\":\"" << escape(classify(record))
+                << "\",\"view\":\"" << escape(record.view)
+                << "\",\"pass\":\"" << escape(record.pass) << "\"";
+            if (record.kind == "pass") {
+                out << ",\"passOrdinal\":" << record.passOrdinal;
+            }
+            out << ",\"gpuNs\":" << record.elapsedNs << '}';
+        }
+        out << "]}";
+        return utils::CString(out.str().c_str());
+    }
+
+private:
+    bool initialize(DriverApi& driver) noexcept {
+        if (mInitialized) {
+            return mSupported;
+        }
+        mInitialized = true;
+        mSupported = driver.isFrameTimeSupported();
+        if (!mSupported) {
+            return false;
+        }
+        for (Slot& slot : mSlots) {
+            slot.handle = driver.createTimerQuery();
+            if (!slot.handle) {
+                mSupported = false;
+                break;
+            }
+        }
+        if (!mSupported) {
+            for (Slot& slot : mSlots) {
+                if (slot.handle) {
+                    driver.destroyTimerQuery(slot.handle);
+                    slot.handle = {};
+                }
+            }
+        }
+        return mSupported;
+    }
+
+    int32_t beginScope(DriverApi& driver, char const* kind,
+            char const* view, char const* pass,
+            uint32_t passOrdinal = UINT32_MAX) noexcept {
+        if (mOutstanding == QUERY_COUNT || mRecords.size() >= RECORD_LIMIT) {
+            mDroppedScopes++;
+            return -1;
+        }
+        Slot& slot = mSlots[mIssueIndex];
+        if (slot.pending || !slot.handle) {
+            mDroppedScopes++;
+            return -1;
+        }
+        slot.pending = true;
+        slot.frameId = mCurrentFrameId;
+        slot.passOrdinal = passOrdinal;
+        slot.kind = kind ? kind : "unknown";
+        slot.view = view ? view : "";
+        slot.pass = pass ? pass : "";
+        int32_t const token = int32_t(mIssueIndex);
+        mIssueIndex = (mIssueIndex + 1u) % QUERY_COUNT;
+        mOutstanding++;
+        driver.beginTimerQuery(slot.handle);
+        return token;
+    }
+
+    void endScope(DriverApi& driver, int32_t token) noexcept {
+        if (token >= 0) {
+            driver.endTimerQuery(mSlots[size_t(token)].handle);
+        }
+    }
+
+    void beginPass(DriverApi& driver, char const* name) noexcept {
+        uint32_t const ordinal = mFramePassOrdinal++;
+        if (ordinal < mPassWindowStart ||
+                ordinal >= mPassWindowStart + PASS_QUERY_BUDGET) {
+            mUnsampledPasses++;
+            mPassToken = -1;
+            return;
+        }
+        mPassToken = beginScope(driver, "pass", mCurrentView.c_str(), name, ordinal);
+    }
+
+    void endPass(DriverApi& driver) noexcept {
+        endScope(driver, mPassToken);
+        mPassToken = -1;
+    }
+
+    void poll(DriverApi& driver, size_t budget) noexcept {
+        while (budget-- && mOutstanding) {
+            Slot& slot = mSlots[mPollIndex];
+            uint64_t elapsed = 0;
+            TimerQueryResult const result = driver.getTimerQueryValue(slot.handle, &elapsed);
+            if (result == TimerQueryResult::NOT_READY) {
+                break;
+            }
+            if (result == TimerQueryResult::AVAILABLE && mRecords.size() < RECORD_LIMIT) {
+                mRecords.push_back({ slot.frameId, elapsed, slot.passOrdinal,
+                        std::move(slot.kind),
+                        std::move(slot.view), std::move(slot.pass) });
+            } else {
+                mErrorScopes++;
+            }
+            slot.pending = false;
+            slot.passOrdinal = UINT32_MAX;
+            slot.kind.clear();
+            slot.view.clear();
+            slot.pass.clear();
+            mPollIndex = (mPollIndex + 1u) % QUERY_COUNT;
+            mOutstanding--;
+        }
+    }
+
+    static std::string escape(std::string const& text) {
+        std::string out;
+        out.reserve(text.size());
+        for (char c : text) {
+            if (c == '\\' || c == '\"') {
+                out.push_back('\\');
+            }
+            if (c == '\n' || c == '\r' || c == '\t') {
+                c = ' ';
+            }
+            out.push_back(c);
+        }
+        return out;
+    }
+
+    static std::string classify(Record const& record) {
+        if (record.kind == "frame") {
+            return "FILAMENT_FRAME";
+        }
+        if (record.kind == "view") {
+            return "VIEW_TOTAL";
+        }
+        std::string name = record.pass;
+        std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) {
+            return char(std::tolower(c));
+        });
+        if (name.find("shadow") != std::string::npos) return "SHADOWS";
+        if (name.find("structure") != std::string::npos ||
+                name.find("depth") != std::string::npos) return "DEPTH_STRUCTURE";
+        if (name.find("ambient occlusion") != std::string::npos ||
+                name.find("ssao") != std::string::npos) return "SSAO";
+        if (name.find("reflection") != std::string::npos ||
+                name.find("ssr") != std::string::npos) return "SSR_REFRACTION";
+        if (name.find("transparent") != std::string::npos) return "TRANSPARENT";
+        if (name.find("bloom") != std::string::npos) return "BLOOM";
+        if (name.find("taa") != std::string::npos ||
+                name.find("fxaa") != std::string::npos ||
+                name.find("anti alias") != std::string::npos) return "ANTI_ALIASING";
+        if (name.find("upscale") != std::string::npos) return "UPSCALE";
+        if (name.find("present") != std::string::npos ||
+                name.find("blit") != std::string::npos) return "PRESENT_BLIT";
+        if (name.find("color") != std::string::npos) return "OPAQUE_COLOR";
+        return "OTHER_OR_MERGED";
+    }
+
+    FEngine& mEngine;
+    std::array<Slot, QUERY_COUNT> mSlots{};
+    std::vector<Record> mRecords;
+    FrameGraph::ExecutionHooks mHooks{};
+    std::string mCurrentView;
+    size_t mIssueIndex = 0;
+    size_t mPollIndex = 0;
+    size_t mOutstanding = 0;
+    uint32_t mCurrentFrameId = 0;
+    uint32_t mFrameOrdinal = 0;
+    uint32_t mSampledFrames = 0;
+    uint32_t mMaxSampledFrames = 120;
+    uint32_t mSamplePeriod = 4;
+    uint32_t mDroppedScopes = 0;
+    uint32_t mErrorScopes = 0;
+    uint32_t mObservedPasses = 0;
+    uint32_t mUnsampledPasses = 0;
+    uint32_t mFramePassOrdinal = 0;
+    uint32_t mPassWindowStart = 0;
+    uint32_t mNextPassWindowStart = 0;
+    int32_t mFrameToken = -1;
+    int32_t mViewToken = -1;
+    int32_t mPassToken = -1;
+    bool mInitialized = false;
+    bool mSupported = false;
+    bool mCapturing = false;
+    bool mSampleFrame = false;
+};
+
 FRenderer::FRenderer(FEngine& engine) :
         mEngine(engine),
         mFrameSkipper(),
         mRenderTargetHandle(engine.getDefaultRenderTarget()),
         mFrameInfoManager(engine, engine.getDriverApi()),
+        mSolumGpuProfiler(std::make_unique<SolumGpuProfiler>(engine)),
         mHdrTranslucent(TextureFormat::RGBA16F),
         mHdrQualityMedium(TextureFormat::R11F_G11F_B10F),
         mHdrQualityHigh(TextureFormat::RGB16F),
@@ -195,6 +583,7 @@ void FRenderer::terminate(FEngine& engine) {
         engine.execute();
     }
 
+    mSolumGpuProfiler->terminate(driver);
     mFrameInfoManager.terminate(engine);
     mFrameSkipper.terminate(driver);
     mResourceAllocator->terminate();
@@ -446,6 +835,7 @@ bool FRenderer::beginFrame(FSwapChain* swapChain, uint64_t vsyncSteadyClockTimeN
         mFrameInfoManager.beginFrame(swapChain, driver, {
             .historySize = mFrameRateOptions.history
         }, mFrameId, appVsync);
+        mSolumGpuProfiler->beginFrame(driver, mFrameId);
 
         // ask the engine to do what it needs to (e.g. updates light buffer, materials...)
         engine.prepare(driver);
@@ -501,6 +891,7 @@ void FRenderer::endFrame() {
     mSwapChain->commit(driver);
     mSwapChain = nullptr;
 
+    mSolumGpuProfiler->endFrame(driver);
     mFrameInfoManager.endFrame(driver);
     mFrameSkipper.submitFrame(driver);
 
@@ -1578,7 +1969,12 @@ void FRenderer::renderJob(DriverApi& driver, RootArenaScope& rootArenaScope, FVi
     //fg.export_graphviz(graphviz, view.getName());
     //DLOG(INFO) << graphviz.c_str();
 
-    fg.execute(driver);
+    FrameGraph::ExecutionHooks const* hooks =
+            mSolumGpuProfiler->beginView(driver, view.getName());
+    fg.execute(driver, hooks);
+    if (hooks) {
+        mSolumGpuProfiler->endView(driver);
+    }
 
     // save the current history entry and destroy the oldest entry
     view.commitFrameHistory(engine);
@@ -1586,4 +1982,13 @@ void FRenderer::renderJob(DriverApi& driver, RootArenaScope& rootArenaScope, FVi
     recordHighWatermark(commandArena.getListener().getHighWatermark());
 }
 
+bool FRenderer::startSolumGpuProfiler(uint32_t const maxSampledFrames,
+        uint32_t const samplePeriod) {
+    return mSolumGpuProfiler->start(maxSampledFrames, samplePeriod);
+}
+
+utils::CString FRenderer::stopSolumGpuProfiler() {
+    return mSolumGpuProfiler->stop();
+}
+
 } // namespace filament
