+void FRenderer::setSolumV1ShadingReuse(FView const* const targetView, bool const enabled,
+        bool const safeToReuse, uint64_t const stateKey) noexcept {
+    bool const newSession = enabled && (!mSolumV1.enabled || mSolumV1.targetView != targetView);
+    if (newSession) {
+        mSolumV1.consideredFrames = 0;
+        mSolumV1.currentFrames = 0;
+        mSolumV1.reusedFrames = 0;
+    }
+    mSolumV1.targetView = targetView;
+    mSolumV1.enabled = enabled;
+    mSolumV1.safeToReuse = enabled && safeToReuse;
+    mSolumV1.stateKey = stateKey;
+    if (!enabled) {
+        mSolumV1.lastDecision = "disabled";
+    }
+}
+
+utils::CString FRenderer::getSolumV1ShadingReuseStats() const {
+    uint64_t const decided = mSolumV1.currentFrames + mSolumV1.reusedFrames;
+    double const ratio = decided ?
+            double(mSolumV1.reusedFrames) / double(decided) : 0.0;
+    std::ostringstream out;
+    out << "{\"enabled\":" << (mSolumV1.enabled ? "true" : "false")
+        << ",\"safe\":" << (mSolumV1.safeToReuse ? "true" : "false")
+        << ",\"considered_frames\":" << mSolumV1.consideredFrames
+        << ",\"current_frames\":" << mSolumV1.currentFrames
+        << ",\"reused_frames\":" << mSolumV1.reusedFrames
+        << ",\"reuse_ratio\":" << ratio
+        << ",\"last_decision\":\"" << mSolumV1.lastDecision << "\"}";
+    return utils::CString(out.str().c_str());
+}
+
