+bool FRenderer::ensureSolumRegionalHistory(
+        FrameGraphTexture::Descriptor const& desc) noexcept {
+    auto const descriptorMatches = [&desc](
+            SolumV1State::RegionalHistorySlot const& slot) noexcept {
+        return slot.desc.width == desc.width && slot.desc.height == desc.height &&
+                slot.desc.depth == desc.depth && slot.desc.levels == desc.levels &&
+                slot.desc.samples == desc.samples && slot.desc.type == desc.type &&
+                slot.desc.format == desc.format;
+    };
+    bool const ready = mSolumV1.regionalHistory[0].color.handle &&
+            mSolumV1.regionalHistory[1].color.handle &&
+            descriptorMatches(mSolumV1.regionalHistory[0]) &&
+            descriptorMatches(mSolumV1.regionalHistory[1]) &&
+            mSolumV1.regionalHistory[0].generation ==
+                    mSolumV1.regionalResourceGeneration &&
+            mSolumV1.regionalHistory[1].generation ==
+                    mSolumV1.regionalResourceGeneration;
+    if (ready) {
+        return true;
+    }
+
+    if (mSolumV1.regionalHistory[0].color.handle ||
+            mSolumV1.regionalHistory[1].color.handle) {
+        invalidateSolumRegionalHistory("descriptor_or_generation_reallocation");
+    }
+
+    uint64_t const generation = ++mSolumV1.regionalResourceGeneration;
+    constexpr auto usage = FrameGraphTexture::Usage::COLOR_ATTACHMENT |
+            FrameGraphTexture::Usage::SAMPLEABLE;
+    auto& first = mSolumV1.regionalHistory[0];
+    auto& second = mSolumV1.regionalHistory[1];
+    first.desc = desc;
+    second.desc = desc;
+    first.generation = generation;
+    second.generation = generation;
+    first.color.create(*mResourceAllocator, "Tessera Regional HDR history A", desc, usage);
+    second.color.create(*mResourceAllocator, "Tessera Regional HDR history B", desc, usage);
