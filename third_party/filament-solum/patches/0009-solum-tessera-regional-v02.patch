diff --git a/filament/src/materials/tesseraRegionalReproject.mat b/filament/src/materials/tesseraRegionalReproject.mat
new file mode 100644
index 0000000..1c86261
--- /dev/null
+++ b/filament/src/materials/tesseraRegionalReproject.mat
@@ -0,0 +1,55 @@
+material {
+    name : tesseraRegionalReproject,
+    parameters : [
+        { type : sampler2d, name : history },
+        { type : sampler2d, name : currentDepth, precision : high, filterable : false },
+        { type : sampler2d, name : previousDepth, precision : high, filterable : false },
+        { type : mat4, name : reprojection, precision : high }
+    ],
+    constants : [
+        { type : bool, name : validityOnly, default : false }
+    ],
+    variables : [ vertex ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false
+}
+
+vertex {
+    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
+        highp vec2 uv = uvToRenderTargetUV(postProcess.normalizedUV);
+        postProcess.vertex.xy = uv;
+        postProcess.vertex.zw = uv;
+    }
+}
+
+fragment {
+    void postProcess(inout PostProcessInputs postProcess) {
+        // Match Filament's proven TAA reprojection coordinate convention exactly: depth uses
+        // render-target UV, while the matrix consumes normalized screen UV before the result is
+        // converted back to the backend render-target convention.
+        highp vec4 uv = variable_vertex;
+        highp float depth = textureLod(materialParams_currentDepth, uv.xy, 0.0).r;
+        uv.zw = uvToRenderTargetUV(uv.zw);
+        highp vec4 q = materialParams.reprojection * vec4(uv.zw, depth, 1.0);
+        highp float invW = q.w > 0.0 ? 1.0 / q.w : 0.0;
+        highp float expectedPreviousDepth = q.z * invW;
+        highp vec2 previousUv = (q.xy * invW) * 0.5 + 0.5;
+        previousUv = uvToRenderTargetUV(previousUv);
+        bool inBounds = q.w > 0.0 && all(greaterThanEqual(previousUv, vec2(0.0))) &&
+                all(lessThanEqual(previousUv, vec2(1.0)));
+        highp float previousDepth = inBounds
+                ? textureLod(materialParams_previousDepth, previousUv, 0.0).r : 0.0;
+        highp float tolerance = max(2.0 * fwidth(expectedPreviousDepth),
+                2.0 / 16777216.0);
+        bool valid = inBounds &&
+                abs(previousDepth - expectedPreviousDepth) <= 2.0 * tolerance;
+        if (materialConstants_validityOnly) {
+            postProcess.color = vec4(valid ? 1.0 : 0.0);
+        } else {
+            postProcess.color = valid
+                    ? textureLod(materialParams_history, previousUv, 0.0)
+                    : vec4(0.0);
+        }
+    }
+}
diff --git a/filament/src/materials/tesseraRegionalStencil.mat b/filament/src/materials/tesseraRegionalStencil.mat
new file mode 100644
index 0000000..c9a73a0
--- /dev/null
+++ b/filament/src/materials/tesseraRegionalStencil.mat
@@ -0,0 +1,29 @@
+material {
+    name : tesseraRegionalStencil,
+    parameters : [
+        { type : sampler2d, name : validity, precision : low, filterable : false },
+        { type : float, name : forceCurrent }
+    ],
+    variables : [ vertex ],
+    domain : postprocess,
+    depthWrite : false,
+    depthCulling : false,
+    culling : none
+}
+
+vertex {
+    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
+        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.normalizedUV);
+    }
+}
+
+fragment {
+    void postProcess(inout PostProcessInputs postProcess) {
+        if (materialParams.forceCurrent < 0.5 &&
+                textureLod(materialParams_validity,
+                        variable_vertex.xy, 0.0).r < 0.5) {
+            discard;
+        }
+        postProcess.color = vec4(0.0);
+    }
+}
