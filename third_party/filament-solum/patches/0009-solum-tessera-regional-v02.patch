+PostProcessManager::TesseraRegionalReprojectionOutput
+PostProcessManager::tesseraRegionalReproject(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const previousColor,
+        FrameGraphId<FrameGraphTexture> const previousDepth,
+        FrameGraphId<FrameGraphTexture> const currentDepth,
+        FrameGraphId<FrameGraphTexture> const currentColor,
+        mat4f const& reprojection) noexcept {
+    struct ReprojectData {
+        FrameGraphId<FrameGraphTexture> previousColor;
+        FrameGraphId<FrameGraphTexture> previousDepth;
+        FrameGraphId<FrameGraphTexture> currentDepth;
+        FrameGraphId<FrameGraphTexture> output;
+    };
+
+    auto addReprojectionPass = [&](char const* const passName,
+            bool const validityOnly) -> FrameGraphId<FrameGraphTexture> {
+        auto const& pass = fg.addPass<ReprojectData>(passName,
+                [&](FrameGraph::Builder& builder, ReprojectData& data) {
+                    data.previousColor = builder.sample(previousColor);
+                    data.previousDepth = builder.sample(previousDepth);
+                    data.currentDepth = builder.sample(currentDepth);
+                    if (validityOnly) {
+                        auto const& desc = builder.getDescriptor(currentColor);
+                        data.output = builder.createTexture(
+                                "Tessera Regional validity", {
+                                    .width = desc.width,
+                                    .height = desc.height,
+                                    .format = TextureFormat::R8,
+                                });
+                    } else {
+                        data.output = currentColor;
+                    }
+                    data.output = builder.write(data.output,
+                            FrameGraphTexture::Usage::COLOR_ATTACHMENT);
+                    builder.declareRenderPass(builder.getName(data.output), {
+                            .attachments = { .color = { data.output } },
+                            .clearFlags = TargetBufferFlags::COLOR,
+                    });
+                },
+                [=, this](FrameGraphResources const& resources,
+                        ReprojectData const& data, DriverApi& driver) {
+                    bindPostProcessDescriptorSet(driver);
+                    bindPerRenderableDescriptorSet(driver);
+                    auto const& material = getPostProcessMaterial(validityOnly
+                            ? "tesseraRegionalReprojectValidity"
+                            : "tesseraRegionalReprojectColor");
+                    FMaterial const* const ma = material.getMaterial(mEngine);
+                    FMaterialInstance* const mi = getMaterialInstance(driver, ma);
+                    mi->setParameter("history", resources.getTexture(data.previousColor),
+                            SamplerParams{
+                                .filterMag = SamplerMagFilter::LINEAR,
+                                .filterMin = SamplerMinFilter::LINEAR,
+                            });
+                    mi->setParameter("currentDepth", resources.getTexture(data.currentDepth),
+                            SamplerParams{});
+                    mi->setParameter("previousDepth", resources.getTexture(data.previousDepth),
+                            SamplerParams{});
+                    mi->setParameter("reprojection", reprojection);
+                    mi->commit(driver, getUboManager());
+                    mi->use(driver);
+                    auto const out = resources.getRenderPassInfo();
+                    renderFullScreenQuad(out, getPipelineState(mi), driver);
+                    unbindAllDescriptorSets(driver);
+                });
+        return pass->output;
+    };
+
+    auto const color = addReprojectionPass(
+            "Tessera Regional history reproject", false);
+    auto const validity = addReprojectionPass(
+            "Tessera Regional validity", true);
+    return { color, validity };
+}
+
+FrameGraphId<FrameGraphTexture> PostProcessManager::tesseraRegionalStencil(
+        FrameGraph& fg, FrameGraphId<FrameGraphTexture> const validity,
+        FrameGraphId<FrameGraphTexture> const currentDepth,
+        bool const hasDirtyScissor, backend::Viewport const dirtyScissor) noexcept {
+    struct StencilData {
+        FrameGraphId<FrameGraphTexture> validity;
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> stencil;
+    };
+    constexpr FrameGraphTexture::Usage DEPTH_STENCIL_USAGE =
+            FrameGraphTexture::Usage::DEPTH_ATTACHMENT |
+            FrameGraphTexture::Usage::STENCIL_ATTACHMENT;
+    auto const& pass = fg.addPass<StencilData>("Tessera Regional validity stencil",
+            [&](FrameGraph::Builder& builder, StencilData& data) {
+                data.validity = builder.sample(validity);
+                data.depth = builder.read(currentDepth, DEPTH_STENCIL_USAGE);
+                data.depth = builder.write(data.depth, DEPTH_STENCIL_USAGE);
+                data.stencil = data.depth;
+                builder.declareRenderPass("Tessera Regional validity stencil target", {
+                        .attachments = { .depth = data.depth, .stencil = data.stencil },
+                        .clearFlags = TargetBufferFlags::STENCIL,
+                });
+            },
+            [=, this](FrameGraphResources const& resources,
+                    StencilData const& data, DriverApi& driver) {
+                bindPostProcessDescriptorSet(driver);
+                bindPerRenderableDescriptorSet(driver);
+                auto const& material = getPostProcessMaterial("tesseraRegionalStencil");
+                FMaterial const* const ma = material.getMaterial(mEngine);
+                FMaterialInstance* const mi = getMaterialInstance(driver, ma);
+                mi->setParameter("validity", resources.getTexture(data.validity),
+                        SamplerParams{});
+                mi->setParameter("forceCurrent", 0.0f);
+                mi->commit(driver, getUboManager());
+                mi->use(driver);
+
+                auto validPipeline = getPipelineState(mi);
+                validPipeline.rasterState.colorWrite = false;
+                validPipeline.rasterState.depthWrite = false;
+                validPipeline.rasterState.depthFunc = SamplerCompareFunc::A;
+                validPipeline.stencilState.stencilWrite = true;
+                validPipeline.stencilState.front.stencilFunc = SamplerCompareFunc::A;
+                validPipeline.stencilState.front.stencilOpDepthStencilPass =
+                        StencilOperation::REPLACE;
+                validPipeline.stencilState.front.ref = 1u;
+                validPipeline.stencilState.back = validPipeline.stencilState.front;
+
+                auto const out = resources.getRenderPassInfo();
+                driver.beginRenderPass(out.target, out.params);
+                driver.draw(validPipeline, mFullScreenQuadRph, 0, 3, 1);
+                if (hasDirtyScissor) {
+                    mi->setParameter("forceCurrent", 1.0f);
+                    mi->commit(driver, getUboManager());
+                    mi->use(driver);
+                    auto dirtyPipeline = validPipeline;
+                    dirtyPipeline.stencilState.front.ref = 0u;
+                    dirtyPipeline.stencilState.back.ref = 0u;
+                    driver.scissor(dirtyScissor);
+                    driver.draw(dirtyPipeline, mFullScreenQuadRph, 0, 3, 1);
+                }
+                driver.endRenderPass();
+                unbindAllDescriptorSets(driver);
+            });
+    return pass->depth;
+}
