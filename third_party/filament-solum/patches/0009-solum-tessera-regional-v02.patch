+FrameGraphId<FrameGraphTexture> RendererUtils::tesseraRegionalDepthPass(
+        FrameGraph& fg, FEngine& engine, FView const& view,
+        FrameGraphId<FrameGraphTexture> const depth,
+        FrameGraphTexture::Descriptor const& colorBufferDesc,
+        ColorPassConfig const& config,
+        RenderPass::Executor passExecutor) noexcept {
+    struct RegionalDepthPassData {
+        FrameGraphId<FrameGraphTexture> depth;
+        FrameGraphId<FrameGraphTexture> stencil;
+    };
+
+    auto const& pass = fg.addPass<RegionalDepthPassData>("Tessera Regional current depth",
+            [&](FrameGraph::Builder& builder, RegionalDepthPassData& data) {
+                FrameGraphTexture::Usage usage = FrameGraphTexture::Usage::DEPTH_ATTACHMENT;
+                if (config.enabledStencilBuffer) {
+                    usage |= FrameGraphTexture::Usage::STENCIL_ATTACHMENT;
+                }
+                data.depth = depth;
+                data.depth = builder.write(data.depth, usage);
+                if (config.enabledStencilBuffer) {
+                    data.stencil = data.depth;
+                }
+                builder.declareRenderPass("Tessera Regional Depth Target", {
+                        .attachments = { .depth = data.depth, .stencil = data.stencil },
+                        .samples = config.msaa,
+                        .layerCount = static_cast<uint8_t>(colorBufferDesc.depth),
+                        .clearFlags = TargetBufferFlags::DEPTH |
+                                (config.enabledStencilBuffer ? TargetBufferFlags::STENCIL :
+                                        TargetBufferFlags::NONE),
+                });
+            },
+            [passExecutor = std::move(passExecutor), &view, &engine](
+                    FrameGraphResources const& resources,
+                    RegionalDepthPassData const&, DriverApi& driver) {
+                view.commitDescriptorSet(driver);
+                auto const out = resources.getRenderPassInfo();
+                driver.beginRenderPass(out.target, out.params);
+                passExecutor.execute(engine, driver);
+                driver.endRenderPass();
+                DescriptorSet::unbind(driver, DescriptorSetBindingPoints::PER_VIEW);
+                DescriptorSet::unbind(driver, DescriptorSetBindingPoints::PER_RENDERABLE);
+                DescriptorSet::unbind(driver, DescriptorSetBindingPoints::PER_MATERIAL);
+            });
+    return pass->depth;
+}
