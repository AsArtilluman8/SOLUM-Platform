@@ -1139,10 +1138,0 @@ void RenderPass::Executor::execute(FEngine const& engine, DriverApi& driver,
-                    // Regional already rendered authoritative current depth with the exact
-                    // depth variant.  Keeping depth writes enabled here makes masked materials
-                    // defer depth/stencil until after their expensive fragment work.  Convert
-                    // only originally depth-writing (opaque / masked) draws to an equal,
-                    // read-only depth test so Vulkan can reject REUSE pixels before PBR.  The
-                    // original depth state is preserved for transparent draws.
-                    if (pipeline.rasterState.depthWrite) {
-                        pipeline.rasterState.depthWrite = false;
-                        pipeline.rasterState.depthFunc = SamplerCompareFunc::E;
-                    }
