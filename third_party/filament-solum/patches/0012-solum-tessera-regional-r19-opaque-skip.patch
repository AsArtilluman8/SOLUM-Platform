+void PostProcessManager::tesseraRegionalCoverageReadback(FrameGraph& fg,
+        FrameGraphId<FrameGraphTexture> const validity,
+        TesseraRegionalCoverageCallback callback) noexcept {
+    struct ReadbackData {
+        FrameGraphId<FrameGraphTexture> validity;
+    };
+    fg.addPass<ReadbackData>("Tessera Regional exact coverage readback",
+            [&](FrameGraph::Builder& builder, ReadbackData& data) {
+                data.validity = builder.read(validity,
+                        FrameGraphTexture::Usage::SAMPLEABLE);
+                builder.sideEffect();
+            },
+            [callback = std::move(callback)](FrameGraphResources const& resources,
+                    ReadbackData const& data, DriverApi& driver) mutable {
+                auto const& desc = resources.getDescriptor(data.validity);
+                auto const texture = resources.getTexture(data.validity);
+                if (!texture || desc.width == 0u || desc.height == 0u) {
+                    if (callback) callback(false, 0u, 0u, desc.width, desc.height);
+                    return;
+                }
+                struct UserData {
+                    uint32_t width;
+                    uint32_t height;
+                    std::vector<uint8_t> pixels;
+                    TesseraRegionalCoverageCallback callback;
+                };
+                size_t const pixelCount = size_t(desc.width) * desc.height;
+                auto user = std::make_unique<UserData>(UserData{
+                        desc.width, desc.height,
+                        std::vector<uint8_t>(pixelCount * 4u),
+                        std::move(callback) });
+                void* const pixels = user->pixels.data();
+                size_t const bytes = user->pixels.size();
+                UserData* const rawUser = user.release();
+                PixelBufferDescriptor buffer(pixels, bytes,
+                        PixelDataFormat::RGBA, PixelDataType::UBYTE,
+                        1, 0, 0, 0, 0,
+                        [](void*, size_t size, void* opaque) {
+                            std::unique_ptr<UserData> completed{
+                                    static_cast<UserData*>(opaque) };
+                            size_t const expected = size_t(completed->width) *
+                                    completed->height * 4u;
+                            if (size < expected) {
+                                if (completed->callback) {
+                                    completed->callback(false, 0u, 0u,
+                                            completed->width, completed->height);
+                                }
+                                return;
+                            }
+                            uint64_t reusePixels = 0u;
+                            size_t const count = size_t(completed->width) *
+                                    completed->height;
+                            for (size_t index = 0; index < count; ++index) {
+                                reusePixels += completed->pixels[index * 4u] >= 128u;
+                            }
+                            if (completed->callback) {
+                                completed->callback(true, reusePixels,
+                                        uint64_t(count) - reusePixels,
+                                        completed->width, completed->height);
+                            }
+                        }, rawUser);
+                auto const subresource = resources.getSubResourceDescriptor(data.validity);
+                driver.readTexture(texture, subresource.level, subresource.layer,
+                        0, 0, desc.width, desc.height, std::move(buffer));
+            });
+}
