+        << ",\"target_view_bound\":"
+        << (mSolumMaskAwareCoverage.targetView ? "true" : "false")
+        << ",\"requested_frames\":" << mSolumMaskAwareCoverage.requestedFrames
+        << ",\"active_frames\":" << mSolumMaskAwareCoverage.activeFrames
+        << ",\"coverage_pass_frames\":"
+        << mSolumMaskAwareCoverage.coveragePassFrames
+        << ",\"eligible_draw_commands\":"
+        << mSolumMaskAwareCoverage.eligibleDrawCommands
+        << ",\"fail_closed_frames\":" << mSolumMaskAwareCoverage.failClosedFrames
+        << ",\"current_visibility_required\":true"
+        << ",\"current_full_resolution_depth\":true"
+        << ",\"masked_color_depth_equal_read_only\":true"
+        << ",\"double_sided_preserved\":true"
+        << ",\"last_reason\":\"" << mSolumMaskAwareCoverage.lastReason << "\"}";
+    return utils::CString(out.str().c_str());
