+void FRenderer::setSolumMaskAwareCoverage(FView const* const targetView,
+        bool const enabled) noexcept {
+    bool const newSession = enabled && (!mSolumMaskAwareCoverage.enabled ||
+            mSolumMaskAwareCoverage.targetView != targetView);
+    if (newSession) {
+        mSolumMaskAwareCoverage.requestedFrames = 0;
+        mSolumMaskAwareCoverage.activeFrames = 0;
+        mSolumMaskAwareCoverage.coveragePassFrames = 0;
+        mSolumMaskAwareCoverage.eligibleDrawCommands = 0;
+        mSolumMaskAwareCoverage.failClosedFrames = 0;
+    }
+    mSolumMaskAwareCoverage.targetView = targetView;
+    mSolumMaskAwareCoverage.enabled = enabled && targetView;
+    mSolumMaskAwareCoverage.actual = false;
+    mSolumMaskAwareCoverage.lastReason = !enabled ? "disabled" :
+            targetView ? "armed_pending_target_frame" : "target_view_missing";
+}
