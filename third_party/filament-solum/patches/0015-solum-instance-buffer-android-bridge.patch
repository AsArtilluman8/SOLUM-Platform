+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <jni.h>
+
+#include <filament/Engine.h>
+#include <filament/InstanceBuffer.h>
+
+#include <math/mat4.h>
+
+#include "common/NioUtils.h"
+#include <common/JniUtils.h>
+
+using namespace filament;
+using namespace filament::android;
+
+extern "C" JNIEXPORT jlong JNICALL
+Java_com_google_android_filament_InstanceBuffer_nCreateBuilder(JNIEnv* env, jclass,
+        jint instanceCount) {
+    return wrapJni<jlong>(env, [=]() {
+        return (jlong) new InstanceBuffer::Builder((size_t) instanceCount);
+    });
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_google_android_filament_InstanceBuffer_nDestroyBuilder(JNIEnv*, jclass,
+        jlong nativeBuilder) {
+    delete (InstanceBuffer::Builder*) nativeBuilder;
+}
+
+extern "C" JNIEXPORT jlong JNICALL
+Java_com_google_android_filament_InstanceBuffer_nBuilderBuild(JNIEnv* env, jclass,
+        jlong nativeBuilder, jlong nativeEngine) {
+    InstanceBuffer::Builder* builder = (InstanceBuffer::Builder*) nativeBuilder;
+    Engine* engine = (Engine*) nativeEngine;
+    return wrapJni<jlong>(env, [=]() {
+        return (jlong) builder->build(*engine);
+    });
+}
+
+extern "C" JNIEXPORT jint JNICALL
+Java_com_google_android_filament_InstanceBuffer_nSetLocalTransforms(JNIEnv* env, jclass,
+        jlong nativeInstanceBuffer, jobject matrices, jint remaining,
+        jint count, jint offset) {
+    InstanceBuffer* instanceBuffer = (InstanceBuffer*) nativeInstanceBuffer;
+    return wrapJni<jint>(env, [=]() {
+        if (count < 0 || offset < 0) return -2;
+        AutoBuffer nioBuffer(env, matrices, (size_t) count * 16u);
+        void* data = nioBuffer.getData();
+        size_t sizeInBytes = nioBuffer.getSize();
+        if (data == nullptr || sizeInBytes > ((size_t) remaining << nioBuffer.getShift())) {
+            return -1;
+        }
+        if ((size_t) offset + (size_t) count > instanceBuffer->getInstanceCount()) {
+            return -2;
+        }
+        instanceBuffer->setLocalTransforms(
+                static_cast<math::mat4f const*>(data), (size_t) count, (size_t) offset);
+        return 0;
+    });
+}
+
+extern "C" JNIEXPORT jint JNICALL
+Java_com_google_android_filament_InstanceBuffer_nGetInstanceCount(JNIEnv*, jclass,
+        jlong nativeInstanceBuffer) {
+    InstanceBuffer* instanceBuffer = (InstanceBuffer*) nativeInstanceBuffer;
+    return (jint) instanceBuffer->getInstanceCount();
+}
