diff --git a/android/filament-android/src/main/java/com/google/android/filament/InstanceBuffer.java b/android/filament-android/src/main/java/com/google/android/filament/InstanceBuffer.java
new file mode 100644
--- /dev/null
+++ b/android/filament-android/src/main/java/com/google/android/filament/InstanceBuffer.java
@@ -0,0 +1,106 @@
+/*
+ * Copyright (C) 2026 SOLUM Platform
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.google.android.filament;
+
+import androidx.annotation.IntRange;
+import androidx.annotation.NonNull;
+
+import java.nio.Buffer;
+import java.nio.BufferOverflowException;
+
+/** Android binding for Filament's exact GPU instance-transform buffer. */
+public class InstanceBuffer {
+    private long mNativeObject;
+
+    private InstanceBuffer(long nativeInstanceBuffer) {
+        mNativeObject = nativeInstanceBuffer;
+    }
+
+    public static class Builder {
+        @SuppressWarnings({"FieldCanBeLocal", "UnusedDeclaration"})
+        private final BuilderFinalizer mFinalizer;
+        private final long mNativeBuilder;
+
+        public Builder(@IntRange(from = 1, to = 32767) int instanceCount) {
+            if (instanceCount < 1 || instanceCount > 32767) {
+                throw new IllegalArgumentException("instanceCount must be in [1, 32767]");
+            }
+            mNativeBuilder = nCreateBuilder(instanceCount);
+            if (mNativeBuilder == 0) {
+                throw new IllegalStateException("Couldn't create InstanceBuffer.Builder");
+            }
+            mFinalizer = new BuilderFinalizer(mNativeBuilder);
+        }
+
+        @NonNull
+        public InstanceBuffer build(@NonNull Engine engine) {
+            long nativeBuffer = nBuilderBuild(mNativeBuilder, engine.getNativeObject());
+            if (nativeBuffer == 0) {
+                throw new IllegalStateException("Couldn't create InstanceBuffer");
+            }
+            return new InstanceBuffer(nativeBuffer);
+        }
+
+        private static class BuilderFinalizer {
+            private final long mNativeObject;
+
+            BuilderFinalizer(long nativeObject) {
+                mNativeObject = nativeObject;
+            }
+
+            @Override
+            public void finalize() {
+                try {
+                    super.finalize();
+                } catch (Throwable ignored) {
+                } finally {
+                    nDestroyBuilder(mNativeObject);
+                }
+            }
+        }
+    }
+
+    /**
+     * Uploads column-major 4x4 local transforms from the Buffer's current position.
+     * The source Buffer is copied by Filament and can be reused after this call.
+     */
+    public void setLocalTransforms(@NonNull Buffer matrices,
+            @IntRange(from = 0) int count, @IntRange(from = 0) int offset) {
+        int result = nSetLocalTransforms(
+                getNativeObject(), matrices, matrices.remaining(), count, offset);
+        if (result == -1) throw new BufferOverflowException();
+        if (result != 0) throw new IndexOutOfBoundsException(
+                "Instance transform range exceeds InstanceBuffer");
+    }
+
+    public int getInstanceCount() {
+        return nGetInstanceCount(getNativeObject());
+    }
+
+    public long getNativeObject() {
+        if (mNativeObject == 0) {
+            throw new IllegalStateException("Calling method on destroyed InstanceBuffer");
+        }
+        return mNativeObject;
+    }
+
+    void clearNativeObject() {
+        mNativeObject = 0;
+    }
+
+    private static native long nCreateBuilder(int instanceCount);
+    private static native void nDestroyBuilder(long nativeBuilder);
+    private static native long nBuilderBuild(long nativeBuilder, long nativeEngine);
+    private static native int nSetLocalTransforms(long nativeInstanceBuffer, Buffer matrices,
+            int remaining, int count, int offset);
+    private static native int nGetInstanceCount(long nativeInstanceBuffer);
+}
