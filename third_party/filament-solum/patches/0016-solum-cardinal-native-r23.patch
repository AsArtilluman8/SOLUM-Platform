@@ -0,0 +1,148 @@
+/*
+ * Copyright (C) 2026 SOLUM Platform
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <jni.h>
+
+#include <filament/CardinalManager.h>
+
+#include <common/JniUtils.h>
+
+#include <cstring>
+#include <vector>
+
+using namespace filament;
+using namespace filament::android;
+
+namespace {
+
+constexpr size_t CARDINAL_WIRE_BYTES = 96;
+
+template<typename T>
+T readWire(uint8_t const* source, size_t offset) noexcept {
+    T value;
+    std::memcpy(&value, source + offset, sizeof(T));
+    return value;
+}
+
+CardinalManager::Decision decode(uint8_t const* source) noexcept {
+    CardinalManager::Decision out;
+    out.stableChunkId = readWire<uint32_t>(source, 0);
+    out.sourceEntity = readWire<uint32_t>(source, 4);
+    out.midHqEntity = readWire<uint32_t>(source, 8);
+    out.midEntity = readWire<uint32_t>(source, 12);
+    out.farEntity = readWire<uint32_t>(source, 16);
+    out.selectedEntity = readWire<uint32_t>(source, 20);
+    out.selectedRepresentation = readWire<uint32_t>(source, 24);
+    out.selectedMaterialVariant = readWire<uint32_t>(source, 28);
+    out.visibility = readWire<uint32_t>(source, 32);
+    out.flags = readWire<uint32_t>(source, 36);
+    out.validityRevision = readWire<uint64_t>(source, 40);
+    out.decisionRevision = readWire<uint64_t>(source, 48);
+    out.importance = readWire<float>(source, 56);
+    out.boundsCenter[0] = readWire<float>(source, 60);
+    out.boundsCenter[1] = readWire<float>(source, 64);
+    out.boundsCenter[2] = readWire<float>(source, 68);
+    out.boundsExtent[0] = readWire<float>(source, 72);
+    out.boundsExtent[1] = readWire<float>(source, 76);
+    out.boundsExtent[2] = readWire<float>(source, 80);
+    out.failClosedMetadata = readWire<uint32_t>(source, 84);
+    out.sourcePrimitiveCount = readWire<uint32_t>(source, 88);
+    out.selectedPrimitiveCount = readWire<uint32_t>(source, 92);
+    return out;
+}
+
+CardinalManager::Resident decodeResident(uint8_t const* source) noexcept {
+    return {
+        readWire<uint32_t>(source, 0),
+        readWire<uint32_t>(source, 4),
+        readWire<uint32_t>(source, 8),
+        readWire<uint32_t>(source, 12)
+    };
+}
+
+} // namespace
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_google_android_filament_CardinalManager_nRequestMode(JNIEnv*, jclass,
+        jlong nativeManager, jint mode, jlong revision) {
+    auto* manager = reinterpret_cast<CardinalManager*>(nativeManager);
+    manager->requestMode(CardinalManager::Mode(mode), uint64_t(revision));
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_google_android_filament_CardinalManager_nPublishDecisions(JNIEnv* env, jclass,
+        jlong nativeManager, jobject records, jint byteOffset, jint count,
+        jlong revision, jboolean replace) {
+    auto* manager = reinterpret_cast<CardinalManager*>(nativeManager);
+    if (!manager || !records || byteOffset < 0 || count < 0 || revision <= 0) return JNI_FALSE;
+    auto* base = static_cast<uint8_t*>(env->GetDirectBufferAddress(records));
+    jlong const capacity = env->GetDirectBufferCapacity(records);
+    size_t const bytes = size_t(count) * CARDINAL_WIRE_BYTES;
+    if (!base || capacity < 0 || size_t(byteOffset) + bytes > size_t(capacity)) return JNI_FALSE;
+    std::vector<CardinalManager::Decision> decoded;
+    decoded.reserve(size_t(count));
+    for (jint i = 0; i < count; ++i) {
+        decoded.push_back(decode(base + byteOffset + size_t(i) * CARDINAL_WIRE_BYTES));
+    }
+    return manager->publishDecisions(decoded.data(), decoded.size(),
+            uint64_t(revision), bool(replace)) ? JNI_TRUE : JNI_FALSE;
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_google_android_filament_CardinalManager_nPublishResidents(JNIEnv* env, jclass,
+        jlong nativeManager, jobject residents, jint byteOffset, jint count, jboolean replace) {
+    auto* manager = reinterpret_cast<CardinalManager*>(nativeManager);
+    if (!manager || !residents || byteOffset < 0 || count < 0) return JNI_FALSE;
+    auto* base = static_cast<uint8_t*>(env->GetDirectBufferAddress(residents));
+    jlong const capacity = env->GetDirectBufferCapacity(residents);
+    size_t const bytes = size_t(count) * sizeof(CardinalManager::Resident);
+    if (!base || capacity < 0 || size_t(byteOffset) + bytes > size_t(capacity)) return JNI_FALSE;
+    std::vector<CardinalManager::Resident> decoded;
+    decoded.reserve(size_t(count));
+    for (jint i = 0; i < count; ++i) {
+        decoded.push_back(decodeResident(base + byteOffset +
+                size_t(i) * sizeof(CardinalManager::Resident)));
+    }
+    return manager->publishResidents(decoded.data(), decoded.size(), bool(replace))
+            ? JNI_TRUE : JNI_FALSE;
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_google_android_filament_CardinalManager_nClearDecisions(JNIEnv*, jclass,
+        jlong nativeManager, jlong revision) {
+    reinterpret_cast<CardinalManager*>(nativeManager)->clearDecisions(uint64_t(revision));
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_google_android_filament_CardinalManager_nRecordJavaSceneMutation(JNIEnv*, jclass,
+        jlong nativeManager, jint adds, jint removes) {
+    reinterpret_cast<CardinalManager*>(nativeManager)->recordJavaSceneMutation(
+            uint32_t(adds), uint32_t(removes));
+}
+
+extern "C" JNIEXPORT jlongArray JNICALL
+Java_com_google_android_filament_CardinalManager_nGetReadback(JNIEnv* env, jclass,
+        jlong nativeManager) {
+    auto const r = reinterpret_cast<CardinalManager*>(nativeManager)->getReadback();
+    jlong values[35] = {
+        jlong(r.requestedMode), jlong(r.actualMode), jlong(r.modeRevision),
+        jlong(r.decisionBufferRevision), jlong(r.presentedModeRevision),
+        jlong(r.presentedDecisionBufferRevision), jlong(r.fallbackReason),
+        jlong(r.decisionBufferBytes), jlong(r.residentSourceCount),
+        jlong(r.residentMidHqCount), jlong(r.residentMidCount), jlong(r.residentFarCount),
+        jlong(r.sourceClusters), jlong(r.midHqClusters), jlong(r.midClusters),
+        jlong(r.farClusters), jlong(r.skippedClusters), jlong(r.frustumSkippedClusters),
+        jlong(r.fallbackClusters), jlong(r.candidateCommands), jlong(r.emittedCommands),
+        jlong(r.commandsRemoved), jlong(r.candidatePrimitives), jlong(r.emittedPrimitives),
+        jlong(r.primitivesRemoved), jlong(r.structureCandidateCommands),
+        jlong(r.structureReusedCommands), jlong(r.structureEmittedCommands),
+        jlong(r.structureCandidatePrimitives), jlong(r.structureAvoidedPrimitives),
+        jlong(r.structureFallbackCount), jlong(r.structureFallbackReason),
+        jlong(r.javaSceneAdds), jlong(r.javaSceneRemoves), jlong(r.generationCount)
+    };
+    jlongArray result = env->NewLongArray(35);
+    if (result) env->SetLongArrayRegion(result, 0, 35, values);
+    return result;
+}
