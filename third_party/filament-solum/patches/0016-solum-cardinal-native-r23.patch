index 0000000000000000000000000000000000000000..c8ce68334364d43c74992372d0355c2e3d8d3b25
--- /dev/null
+++ b/android/filament-android/src/main/java/com/google/android/filament/CardinalManager.java
@@ -0,0 +1,183 @@
+/*
+ * Copyright (C) 2026 SOLUM Platform
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.google.android.filament;
+
+import androidx.annotation.IntRange;
+import androidx.annotation.NonNull;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Atomic Android bridge for Filament's SOLUM Cardinal execution backend. */
+public final class CardinalManager {
+    public static final int MODE_BASELINE_SOURCE = 0;
+    public static final int MODE_CARDINAL_NATIVE = 1;
+    public static final int MODE_CARDINAL_NATIVE_STRUCTURE_REUSE = 2;
+
+    public static final int REPRESENTATION_SOURCE = 0;
+    public static final int REPRESENTATION_MID_HQ = 1;
+    public static final int REPRESENTATION_MID = 2;
+    public static final int REPRESENTATION_FAR = 3;
+    public static final int REPRESENTATION_SKIP = 4;
+
+    public static final int MATERIAL_SOURCE = 0;
+    public static final int MATERIAL_MID = 1;
+    public static final int MATERIAL_FAR = 2;
+
+    public static final int VISIBILITY_RENDER = 0;
+    public static final int VISIBILITY_PROVEN_OUTSIDE_FRUSTUM = 1;
+    public static final int VISIBILITY_UNCERTAIN = 2;
+
+    public static final int FLAG_INTERACTION_SAFE = 0x1;
+    public static final int FLAG_IMPORTANT = 0x2;
+    public static final int FLAG_STRUCTURE_STATIC_SAFE = 0x4;
+
+    public static final int DECISION_RECORD_BYTES = 96;
+    public static final int RESIDENT_RECORD_BYTES = 16;
+
+    private final long mNativeObject;
+
+    CardinalManager(long nativeObject) {
+        if (nativeObject == 0) throw new IllegalStateException("CardinalManager unavailable");
+        mNativeObject = nativeObject;
+    }
+
+    public void requestMode(@IntRange(from = 0, to = 2) int mode, long modeRevision) {
+        if (mode < MODE_BASELINE_SOURCE || mode > MODE_CARDINAL_NATIVE_STRUCTURE_REUSE) {
+            throw new IllegalArgumentException("Unknown Cardinal mode " + mode);
+        }
+        nRequestMode(mNativeObject, mode, modeRevision);
+    }
+
+    /** Publishes fixed 96-byte little/native-endian records. The native side copies the payload. */
+    public boolean publishDecisions(@NonNull ByteBuffer records,
+            @IntRange(from = 0) int recordCount, long decisionRevision, boolean replace) {
+        if (!records.isDirect() || records.order() != ByteOrder.nativeOrder()) {
+            throw new IllegalArgumentException("Cardinal records require direct native-order buffer");
+        }
+        int byteCount = Math.multiplyExact(recordCount, DECISION_RECORD_BYTES);
+        if (recordCount < 0 || records.remaining() < byteCount || decisionRevision <= 0) {
+            throw new IllegalArgumentException("Cardinal decision range/revision invalid");
+        }
+        return nPublishDecisions(mNativeObject, records, records.position(),
+                recordCount, decisionRevision, replace);
+    }
+
+    /** Replaces or incrementally extends the persistent resident resource registry. */
+    public boolean publishResidents(@NonNull ByteBuffer residents,
+            @IntRange(from = 0) int residentCount, boolean replace) {
+        if (!residents.isDirect() || residents.order() != ByteOrder.nativeOrder()) {
+            throw new IllegalArgumentException("Cardinal residents require direct native-order buffer");
+        }
+        int byteCount = Math.multiplyExact(residentCount, RESIDENT_RECORD_BYTES);
+        if (residentCount < 0 || residents.remaining() < byteCount) {
+            throw new IllegalArgumentException("Cardinal resident range invalid");
+        }
+        return nPublishResidents(mNativeObject, residents, residents.position(),
+                residentCount, replace);
+    }
+
+    public void clearDecisions(long decisionRevision) {
+        if (decisionRevision <= 0) throw new IllegalArgumentException("revision must be positive");
+        nClearDecisions(mNativeObject, decisionRevision);
+    }
+
+    public void recordJavaSceneMutation(int adds, int removes) {
+        if (adds < 0 || removes < 0) throw new IllegalArgumentException("negative scene mutation");
+        nRecordJavaSceneMutation(mNativeObject, adds, removes);
+    }
+
+    @NonNull
+    public Readback getReadback() {
+        long[] values = nGetReadback(mNativeObject);
+        if (values == null || values.length != Readback.VALUE_COUNT) {
+            throw new IllegalStateException("Cardinal native readback ABI mismatch");
+        }
+        return new Readback(values);
+    }
+
+    /** Writes one record at the buffer's current position and advances it by 96 bytes. */
+    public static void putDecision(@NonNull ByteBuffer out,
+            int stableChunkId, int sourceEntity, int midHqEntity, int midEntity, int farEntity,
+            int selectedEntity, int selectedRepresentation, int selectedMaterialVariant,
+            int visibility, int flags, long validityRevision, long decisionRevision,
+            float importance, float centerX, float centerY, float centerZ,
+            float extentX, float extentY, float extentZ, int failClosedMetadata,
+            int sourcePrimitiveCount, int selectedPrimitiveCount) {
+        if (!out.isDirect() || out.order() != ByteOrder.nativeOrder() ||
+                out.remaining() < DECISION_RECORD_BYTES) {
+            throw new IllegalArgumentException("Cardinal decision buffer invalid");
+        }
+        int start = out.position();
+        out.putInt(stableChunkId).putInt(sourceEntity).putInt(midHqEntity).putInt(midEntity)
+            .putInt(farEntity).putInt(selectedEntity).putInt(selectedRepresentation)
+            .putInt(selectedMaterialVariant).putInt(visibility).putInt(flags)
+            .putLong(validityRevision).putLong(decisionRevision).putFloat(importance)
+            .putFloat(centerX).putFloat(centerY).putFloat(centerZ)
+            .putFloat(extentX).putFloat(extentY).putFloat(extentZ)
+            .putInt(failClosedMetadata).putInt(sourcePrimitiveCount)
+            .putInt(selectedPrimitiveCount);
+        if (out.position() - start != DECISION_RECORD_BYTES) {
+            throw new AssertionError("Cardinal decision ABI drift");
+        }
+    }
+
+    public static void putResident(@NonNull ByteBuffer out, int stableChunkId,
+            int entity, int representation, int flags) {
+        if (!out.isDirect() || out.order() != ByteOrder.nativeOrder() ||
+                out.remaining() < RESIDENT_RECORD_BYTES) {
+            throw new IllegalArgumentException("Cardinal resident buffer invalid");
+        }
+        out.putInt(stableChunkId).putInt(entity).putInt(representation).putInt(flags);
+    }
+
+    public static final class Readback {
+        static final int VALUE_COUNT = 35;
+        public final int requestedMode;
+        public final int actualMode;
+        public final long modeRevision;
+        public final long decisionBufferRevision;
+        public final long presentedModeRevision;
+        public final long presentedDecisionBufferRevision;
+        public final int fallbackReason;
+        public final long decisionBufferBytes;
+        public final long residentSourceCount, residentMidHqCount, residentMidCount, residentFarCount;
+        public final long sourceClusters, midHqClusters, midClusters, farClusters, skippedClusters;
+        public final long frustumSkippedClusters, fallbackClusters;
+        public final long candidateCommands, emittedCommands, commandsRemoved;
+        public final long candidatePrimitives, emittedPrimitives, primitivesRemoved;
+        public final long structureCandidateCommands, structureReusedCommands,
+            structureEmittedCommands, structureCandidatePrimitives, structureAvoidedPrimitives,
+            structureFallbackCount;
+        public final int structureFallbackReason;
+        public final long javaSceneAdds, javaSceneRemoves, generationCount;
+
+        Readback(long[] v) {
+            requestedMode = (int)v[0]; actualMode = (int)v[1]; modeRevision = v[2];
+            decisionBufferRevision = v[3]; presentedModeRevision = v[4];
+            presentedDecisionBufferRevision = v[5]; fallbackReason = (int)v[6];
+            decisionBufferBytes = v[7]; residentSourceCount = v[8]; residentMidHqCount = v[9];
+            residentMidCount = v[10]; residentFarCount = v[11]; sourceClusters = v[12];
+            midHqClusters = v[13]; midClusters = v[14]; farClusters = v[15];
+            skippedClusters = v[16]; frustumSkippedClusters = v[17]; fallbackClusters = v[18];
+            candidateCommands = v[19]; emittedCommands = v[20]; commandsRemoved = v[21];
+            candidatePrimitives = v[22]; emittedPrimitives = v[23]; primitivesRemoved = v[24];
+            structureCandidateCommands = v[25]; structureReusedCommands = v[26];
+            structureEmittedCommands = v[27]; structureCandidatePrimitives = v[28];
+            structureAvoidedPrimitives = v[29]; structureFallbackCount = v[30];
+            structureFallbackReason = (int)v[31]; javaSceneAdds = v[32]; javaSceneRemoves = v[33];
+            generationCount = v[34];
+        }
+    }
+
+    private static native void nRequestMode(long nativeManager, int mode, long revision);
+    private static native boolean nPublishDecisions(long nativeManager, ByteBuffer records,
+            int byteOffset, int count, long revision, boolean replace);
+    private static native boolean nPublishResidents(long nativeManager, ByteBuffer residents,
+            int byteOffset, int count, boolean replace);
+    private static native void nClearDecisions(long nativeManager, long revision);
+    private static native void nRecordJavaSceneMutation(long nativeManager, int adds, int removes);
+    private static native long[] nGetReadback(long nativeManager);
+}
