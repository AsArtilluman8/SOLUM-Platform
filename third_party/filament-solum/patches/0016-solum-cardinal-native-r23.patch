+/*
+ * Copyright (C) 2026 SOLUM Platform
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "details/CardinalManager.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+namespace filament {
+
+FCardinalManager::FCardinalManager() noexcept {
+    auto empty = std::make_shared<Generation>();
+    empty->valid = false;
+    empty->invalidReason = FallbackReason::MISSING_DECISION_BUFFER;
+    mPending = empty;
+    mActive = empty;
+}
+
+FCardinalManager::~FCardinalManager() noexcept = default;
+
+bool FCardinalManager::validRepresentation(uint32_t const value) noexcept {
+    return value <= uint32_t(Representation::SKIP);
+}
+
+bool FCardinalManager::validMaterialVariant(uint32_t const value) noexcept {
+    return value <= uint32_t(MaterialVariant::FAR);
+}
+
+bool FCardinalManager::validVisibility(uint32_t const value) noexcept {
+    return value <= uint32_t(Visibility::UNCERTAIN);
+}
+
+std::shared_ptr<FCardinalManager::Generation> FCardinalManager::buildGeneration(
+        std::unordered_map<uint32_t, Decision>&& records,
+        std::unordered_map<uint32_t, EntityEntry> const& residents,
+        uint64_t const revision) noexcept {
+    auto generation = std::make_shared<Generation>();
+    generation->revision = revision;
+    generation->records = std::move(records);
+    generation->bytes = generation->records.size() * sizeof(Decision);
+    generation->valid = !generation->records.empty();
+    generation->invalidReason = generation->valid
+            ? FallbackReason::NONE : FallbackReason::MISSING_DECISION_BUFFER;
+
+    generation->entities = residents;
+    for (auto& [unused, entry] : generation->entities) {
+        (void) unused;
+        entry.selected = false;
+        generation->residentSourceCount += entry.tier == Representation::SOURCE;
+        generation->residentMidHqCount += entry.tier == Representation::MID_HQ;
+        generation->residentMidCount += entry.tier == Representation::MID;
+        generation->residentFarCount += entry.tier == Representation::FAR;
+    }
+
+    for (auto const& [chunkId, decision] : generation->records) {
+        if (!chunkId || chunkId != decision.stableChunkId || !decision.sourceEntity ||
+                !validRepresentation(decision.selectedRepresentation) ||
+                !validMaterialVariant(decision.selectedMaterialVariant) ||
+                !validVisibility(decision.visibility) ||
+                !std::isfinite(decision.importance)) {
+            generation->valid = false;
+            generation->invalidReason = FallbackReason::INVALID_RECORD;
+            break;
+        }
+        Representation const selected = Representation(decision.selectedRepresentation);
+        MaterialVariant const material = MaterialVariant(decision.selectedMaterialVariant);
+        MaterialVariant const expectedMaterial = selected == Representation::FAR
+                ? MaterialVariant::FAR
+                : selected == Representation::MID ? MaterialVariant::MID
+                                                   : MaterialVariant::SOURCE;
+        if (selected != Representation::SKIP && material != expectedMaterial) {
+            generation->valid = false;
+            generation->invalidReason = FallbackReason::MATERIAL_VARIANT_MISMATCH;
+            break;
+        }
+        uint32_t tierEntity = decision.sourceEntity;
+        switch (selected) {
+            case Representation::SOURCE: tierEntity = decision.sourceEntity; break;
+            case Representation::MID_HQ: tierEntity = decision.midHqEntity; break;
+            case Representation::MID: tierEntity = decision.midEntity; break;
+            case Representation::FAR: tierEntity = decision.farEntity; break;
+            case Representation::SKIP: tierEntity = 0; break;
+        }
+        if (selected != Representation::SKIP &&
+                (tierEntity == 0 || decision.selectedEntity != tierEntity)) {
+            generation->valid = false;
+            generation->invalidReason = tierEntity == 0
+                    ? FallbackReason::MISSING_SELECTED_HANDLE
+                    : FallbackReason::SELECTED_HANDLE_TIER_MISMATCH;
+            break;
+        }
+        auto const sourcePos = generation->entities.find(decision.sourceEntity);
+        auto const selectedPos = selected == Representation::SKIP
+                ? generation->entities.end() : generation->entities.find(decision.selectedEntity);
+        if (sourcePos == generation->entities.end() || !sourcePos->second.source ||
+                sourcePos->second.stableChunkId != decision.stableChunkId ||
+                (selected != Representation::SKIP &&
+                    (selectedPos == generation->entities.end() ||
+                     selectedPos->second.stableChunkId != decision.stableChunkId ||
+                     selectedPos->second.tier != selected))) {
+            generation->valid = false;
+            generation->invalidReason = FallbackReason::SELECTED_HANDLE_TIER_MISMATCH;
+            break;
+        }
+        if (selectedPos != generation->entities.end()) selectedPos->second.selected = true;
+    }
+
+    if (!generation->valid) {
+        generation->entities.clear();
+    }
+    return generation;
+}
+
+void FCardinalManager::requestMode(Mode const mode, uint64_t const revision) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mRequestedMode = mode;
+    mModeRevision = std::max(mModeRevision + 1u, revision);
+}
+
+bool FCardinalManager::publishDecisions(Decision const* decisions, size_t const count,
+        uint64_t const revision, bool const replace) noexcept {
+    if ((count && decisions == nullptr) || revision == 0) return false;
+    std::lock_guard<std::mutex> lock(mMutex);
+    std::unordered_map<uint32_t, Decision> records;
+    if (!replace && mPending) records = mPending->records;
+    for (size_t i = 0; i < count; ++i) {
+        Decision const& decision = decisions[i];
+        if (!decision.stableChunkId) return false;
+        records[decision.stableChunkId] = decision;
+    }
+    mPending = buildGeneration(std::move(records), mResidents, revision);
+    mCounters.generationCount++;
+    return mPending->valid;
+}
+
+bool FCardinalManager::publishResidents(Resident const* residents, size_t const count,
+        bool const replace) noexcept {
+    if (count && residents == nullptr) return false;
+    std::lock_guard<std::mutex> lock(mMutex);
+    auto next = replace ? std::unordered_map<uint32_t, EntityEntry>{} : mResidents;
+    for (size_t i = 0; i < count; ++i) {
+        Resident const& resident = residents[i];
+        if (!resident.stableChunkId || !resident.entity ||
+                resident.representation > uint32_t(Representation::FAR)) return false;
+        EntityEntry const entry{ resident.stableChunkId,
+                Representation(resident.representation), false,
+                Representation(resident.representation) == Representation::SOURCE };
+        auto const pos = next.find(resident.entity);
+        if (pos != next.end() && (pos->second.stableChunkId != entry.stableChunkId ||
+                pos->second.tier != entry.tier)) return false;
+        next[resident.entity] = entry;
+    }
+    mResidents = std::move(next);
+    auto records = mPending ? mPending->records : std::unordered_map<uint32_t, Decision>{};
+    uint64_t const revision = mPending ? mPending->revision : 0;
+    mPending = buildGeneration(std::move(records), mResidents, revision);
+    return !mResidents.empty();
+}
+
+void FCardinalManager::clearDecisions(uint64_t const revision) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mPending = buildGeneration({}, mResidents, revision);
+    mCounters.generationCount++;
+}
+
+void FCardinalManager::recordJavaSceneMutation(
+        uint32_t const adds, uint32_t const removes) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mCounters.javaSceneAdds += adds;
+    mCounters.javaSceneRemoves += removes;
+}
+
+void FCardinalManager::beginFrame(uint64_t const frameId) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mFrameId = frameId;
+    mActive = mPending;
+    mActiveModeRevision = mModeRevision;
+    mFallbackReason = FallbackReason::NONE;
+    mActualMode = mRequestedMode;
+    if (mRequestedMode != Mode::BASELINE_SOURCE && (!mActive || !mActive->valid)) {
+        mActualMode = Mode::BASELINE_SOURCE;
+        mFallbackReason = mActive ? mActive->invalidReason
+                                  : FallbackReason::MISSING_DECISION_BUFFER;
+    }
+
+    uint64_t const generations = mCounters.generationCount;
+    uint64_t const adds = mCounters.javaSceneAdds;
+    uint64_t const removes = mCounters.javaSceneRemoves;
+    mCounters = {};
+    mCounters.generationCount = generations;
+    mCounters.javaSceneAdds = adds;
+    mCounters.javaSceneRemoves = removes;
+    mCounters.requestedMode = mRequestedMode;
+    mCounters.actualMode = mActualMode;
+    mCounters.modeRevision = mActiveModeRevision;
+    mCounters.decisionBufferRevision = mActive ? mActive->revision : 0;
+    mCounters.presentedModeRevision = mPresentedModeRevision;
+    mCounters.presentedDecisionBufferRevision = mPresentedDecisionRevision;
+    mCounters.fallbackReason = mFallbackReason;
+    if (mActive) {
+        mCounters.decisionBufferBytes = mActive->bytes;
+        mCounters.residentSourceCount = mActive->residentSourceCount;
+        mCounters.residentMidHqCount = mActive->residentMidHqCount;
+        mCounters.residentMidCount = mActive->residentMidCount;
+        mCounters.residentFarCount = mActive->residentFarCount;
+        for (auto const& [unused, decision] : mActive->records) {
+            (void) unused;
+            if (mActualMode == Mode::BASELINE_SOURCE) {
+                mCounters.sourceClusters++;
+                continue;
+            }
+            if (Visibility(decision.visibility) == Visibility::PROVEN_OUTSIDE_FRUSTUM ||
+                    Representation(decision.selectedRepresentation) == Representation::SKIP) {
+                mCounters.skippedClusters++;
+                continue;
+            }
+            switch (Representation(decision.selectedRepresentation)) {
+                case Representation::SOURCE: mCounters.sourceClusters++; break;
+                case Representation::MID_HQ: mCounters.midHqClusters++; break;
+                case Representation::MID: mCounters.midClusters++; break;
+                case Representation::FAR: mCounters.farClusters++; break;
+                case Representation::SKIP: break;
+            }
+        }
+    }
+}
+
+void FCardinalManager::markPresented() noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mPresentedModeRevision = mActiveModeRevision;
+    mPresentedDecisionRevision = mActive ? mActive->revision : 0;
+    mCounters.presentedModeRevision = mPresentedModeRevision;
+    mCounters.presentedDecisionBufferRevision = mPresentedDecisionRevision;
+}
+
+FCardinalManager::EntityResolution FCardinalManager::resolveEntity(
+        uint32_t const entityId) const noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    auto const& entities = mActive && mActive->valid ? mActive->entities : mResidents;
+    auto const pos = entities.find(entityId);
+    if (pos == entities.end()) return {};
+    EntityEntry const& entry = pos->second;
+    bool emit = entry.source;
+    if (mActualMode != Mode::BASELINE_SOURCE) {
+        auto const decisionPos = mActive->records.find(entry.stableChunkId);
+        if (decisionPos == mActive->records.end()) {
+            emit = entry.source;
+        } else {
+            Decision const& decision = decisionPos->second;
+            bool const skipped = Visibility(decision.visibility) ==
+                    Visibility::PROVEN_OUTSIDE_FRUSTUM ||
+                    Representation(decision.selectedRepresentation) == Representation::SKIP;
+            emit = !skipped && entityId == decision.selectedEntity;
+        }
+    }
+    return { entry.stableChunkId, true, emit, entry.source };
+}
+
+void FCardinalManager::observeResident(uint32_t const entityId,
+        uint32_t const renderPrimitiveCount, uint64_t const triangleCount) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    auto const pos = mResidents.find(entityId);
+    if (pos == mResidents.end() || !pos->second.source) return;
+    mCounters.candidateCommands += renderPrimitiveCount;
+    mCounters.candidatePrimitives += triangleCount;
+}
+
+void FCardinalManager::recordFrustum(
+        uint32_t const stableChunkId, bool const visible) noexcept {
+    if (!stableChunkId || visible) return;
+    std::lock_guard<std::mutex> lock(mMutex);
+    mCounters.frustumSkippedClusters++;
+}
+
+void FCardinalManager::recordPassCommands(PassKind const kind,
+        uint64_t const commands, uint64_t const triangles) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (kind == PassKind::MAIN) {
+        mCounters.emittedCommands += commands;
+        mCounters.emittedPrimitives += triangles;
+        mCounters.commandsRemoved = mCounters.candidateCommands > mCounters.emittedCommands
+                ? mCounters.candidateCommands - mCounters.emittedCommands : 0;
+        mCounters.primitivesRemoved = mCounters.candidatePrimitives > mCounters.emittedPrimitives
+                ? mCounters.candidatePrimitives - mCounters.emittedPrimitives : 0;
+    } else if (kind == PassKind::STRUCTURE) {
+        mCounters.structureCandidateCommands = mCounters.candidateCommands;
+        mCounters.structureCandidatePrimitives = mCounters.candidatePrimitives;
+        mCounters.structureEmittedCommands += commands;
+    }
+}
+
+bool FCardinalManager::structureReuseRequested() const noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return mActualMode == Mode::CARDINAL_NATIVE_STRUCTURE_REUSE;
+}
+
+bool FCardinalManager::structureDecisionSafe() const noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mActualMode != Mode::CARDINAL_NATIVE_STRUCTURE_REUSE ||
+            !mActive || !mActive->valid) return false;
+    for (auto const& [unused, decision] : mActive->records) {
+        (void) unused;
+        bool const skipped = Visibility(decision.visibility) ==
+                Visibility::PROVEN_OUTSIDE_FRUSTUM ||
+                Representation(decision.selectedRepresentation) == Representation::SKIP;
+        if (!skipped && !(decision.flags & STRUCTURE_STATIC_SAFE)) return false;
+    }
+    return true;
+}
+
+void FCardinalManager::recordStructureReuse(
+        uint64_t const commands, uint64_t const triangles) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mCounters.structureReusedCommands += commands;
+    mCounters.structureAvoidedPrimitives += triangles;
+    mCounters.structureFallbackReason = FallbackReason::NONE;
+}
+
+void FCardinalManager::recordStructureFallback(FallbackReason const reason) noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mCounters.structureFallbackCount++;
+    mCounters.structureFallbackReason = reason;
+}
+
+CardinalManager::Readback FCardinalManager::getReadback() const noexcept {
+    std::lock_guard<std::mutex> lock(mMutex);
+    Readback out = mCounters;
+    out.requestedMode = mRequestedMode;
+    out.actualMode = mActualMode;
+    out.modeRevision = mActiveModeRevision;
+    out.decisionBufferRevision = mActive ? mActive->revision : 0;
+    out.presentedModeRevision = mPresentedModeRevision;
+    out.presentedDecisionBufferRevision = mPresentedDecisionRevision;
+    out.fallbackReason = mFallbackReason;
+    return out;
+}
+
+} // namespace filament
