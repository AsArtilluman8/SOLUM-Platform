+    void recordPassCommands(PassKind kind, uint64_t commands, uint64_t triangles) noexcept;
+    bool structureReuseRequested() const noexcept;
+    bool structureDecisionSafe() const noexcept;
+    void recordStructureReuse(uint64_t commands, uint64_t triangles) noexcept;
+    void recordStructureFallback(FallbackReason reason) noexcept;
+
+private:
+    struct EntityEntry {
+        uint32_t stableChunkId = 0;
+        Representation tier = Representation::SOURCE;
+        bool selected = false;
+        bool source = false;
+    };
+
+    struct Generation {
+        uint64_t revision = 0;
+        bool valid = false;
+        FallbackReason invalidReason = FallbackReason::NONE;
+        std::unordered_map<uint32_t, Decision> records;
+        std::unordered_map<uint32_t, EntityEntry> entities;
+        uint64_t bytes = 0;
+        uint64_t residentSourceCount = 0;
+        uint64_t residentMidHqCount = 0;
+        uint64_t residentMidCount = 0;
+        uint64_t residentFarCount = 0;
+    };
+
+    static std::shared_ptr<Generation> buildGeneration(
+            std::unordered_map<uint32_t, Decision>&& records,
+            std::unordered_map<uint32_t, EntityEntry> const& residents,
+            uint64_t revision) noexcept;
+    static bool validRepresentation(uint32_t value) noexcept;
+    static bool validMaterialVariant(uint32_t value) noexcept;
+    static bool validVisibility(uint32_t value) noexcept;
+
+    mutable std::mutex mMutex;
+    std::shared_ptr<const Generation> mPending;
+    std::shared_ptr<const Generation> mActive;
+    std::unordered_map<uint32_t, EntityEntry> mResidents;
+    Mode mRequestedMode = Mode::BASELINE_SOURCE;
+    Mode mActualMode = Mode::BASELINE_SOURCE;
+    uint64_t mModeRevision = 0;
+    uint64_t mActiveModeRevision = 0;
+    uint64_t mPresentedModeRevision = 0;
+    uint64_t mPresentedDecisionRevision = 0;
+    uint64_t mFrameId = 0;
+    FallbackReason mFallbackReason = FallbackReason::NONE;
+    Readback mCounters;
+};
+
+FILAMENT_DOWNCAST(CardinalManager)
+
+} // namespace filament
+
+#endif // TNT_FILAMENT_DETAILS_CARDINALMANAGER_H
