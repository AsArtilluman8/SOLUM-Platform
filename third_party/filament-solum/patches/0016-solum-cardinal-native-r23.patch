diff --git a/filament/include/filament/CardinalManager.h b/filament/include/filament/CardinalManager.h
new file mode 100644
index 0000000000000000000000000000000000000000..bc8d027c7be419a8336fbfde0716af4a58ab4780
--- /dev/null
+++ b/filament/include/filament/CardinalManager.h
@@ -0,0 +1,153 @@
+/*
+ * Copyright (C) 2026 SOLUM Platform
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef TNT_FILAMENT_CARDINALMANAGER_H
+#define TNT_FILAMENT_CARDINALMANAGER_H
+
+#include <filament/FilamentAPI.h>
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace filament {
+
+/**
+ * Native execution boundary for decisions authored by SOLUM Sensus Conductor.
+ *
+ * CardinalManager does not select a representation. It atomically consumes immutable decision
+ * generations and removes non-selected resident renderables before Filament command generation.
+ */
+class UTILS_PUBLIC CardinalManager {
+public:
+    enum class Mode : uint8_t {
+        BASELINE_SOURCE = 0,
+        CARDINAL_NATIVE = 1,
+        CARDINAL_NATIVE_STRUCTURE_REUSE = 2
+    };
+
+    enum class Representation : uint8_t {
+        SOURCE = 0,
+        MID_HQ = 1,
+        MID = 2,
+        FAR = 3,
+        SKIP = 4
+    };
+
+    enum class MaterialVariant : uint8_t {
+        SOURCE = 0,
+        MID = 1,
+        FAR = 2
+    };
+
+    enum class Visibility : uint8_t {
+        RENDER = 0,
+        PROVEN_OUTSIDE_FRUSTUM = 1,
+        UNCERTAIN = 2
+    };
+
+    enum class FallbackReason : uint8_t {
+        NONE = 0,
+        MISSING_DECISION_BUFFER = 1,
+        INVALID_RECORD = 2,
+        DUPLICATE_ENTITY = 3,
+        MISSING_SELECTED_HANDLE = 4,
+        SELECTED_HANDLE_TIER_MISMATCH = 5,
+        MATERIAL_VARIANT_MISMATCH = 6,
+        STRUCTURE_HISTORY_MISSING = 7,
+        STRUCTURE_DESCRIPTOR_MISMATCH = 8,
+        STRUCTURE_CAMERA_MISMATCH = 9,
+        STRUCTURE_SCENE_MISMATCH = 10,
+        STRUCTURE_DYNAMIC_UNSAFE = 11,
+        STRUCTURE_PICKING_INCOMPATIBLE = 12
+    };
+
+    enum DecisionFlags : uint32_t {
+        INTERACTION_SAFE = 0x1u,
+        IMPORTANT = 0x2u,
+        STRUCTURE_STATIC_SAFE = 0x4u
+    };
+
+    /** Fixed 96-byte native record; Android wire format uses these exact field offsets. */
+    struct Decision {
+        uint32_t stableChunkId = 0;
+        uint32_t sourceEntity = 0;
+        uint32_t midHqEntity = 0;
+        uint32_t midEntity = 0;
+        uint32_t farEntity = 0;
+        uint32_t selectedEntity = 0;
+        uint32_t selectedRepresentation = 0;
+        uint32_t selectedMaterialVariant = 0;
+        uint32_t visibility = 0;
+        uint32_t flags = 0;
+        uint64_t validityRevision = 0;
+        uint64_t decisionRevision = 0;
+        float importance = 0.0f;
+        float boundsCenter[3] = {};
+        float boundsExtent[3] = {};
+        uint32_t failClosedMetadata = 0;
+        uint32_t sourcePrimitiveCount = 0;
+        uint32_t selectedPrimitiveCount = 0;
+    };
+    static_assert(sizeof(Decision) == 96, "Cardinal Decision wire ABI must remain 96 bytes");
+
+    /** Persistent resident resource identity. Multiple candidates may share one semantic tier. */
+    struct Resident {
+        uint32_t stableChunkId = 0;
+        uint32_t entity = 0;
+        uint32_t representation = 0;
+        uint32_t flags = 0;
+    };
+    static_assert(sizeof(Resident) == 16, "Cardinal Resident wire ABI must remain 16 bytes");
+
+    struct Readback {
+        Mode requestedMode = Mode::BASELINE_SOURCE;
+        Mode actualMode = Mode::BASELINE_SOURCE;
+        uint64_t modeRevision = 0;
+        uint64_t decisionBufferRevision = 0;
+        uint64_t presentedModeRevision = 0;
+        uint64_t presentedDecisionBufferRevision = 0;
+        FallbackReason fallbackReason = FallbackReason::NONE;
+        uint64_t decisionBufferBytes = 0;
+        uint64_t residentSourceCount = 0;
+        uint64_t residentMidHqCount = 0;
+        uint64_t residentMidCount = 0;
+        uint64_t residentFarCount = 0;
+        uint64_t sourceClusters = 0;
+        uint64_t midHqClusters = 0;
+        uint64_t midClusters = 0;
+        uint64_t farClusters = 0;
+        uint64_t skippedClusters = 0;
+        uint64_t frustumSkippedClusters = 0;
+        uint64_t fallbackClusters = 0;
+        uint64_t candidateCommands = 0;
+        uint64_t emittedCommands = 0;
+        uint64_t commandsRemoved = 0;
+        uint64_t candidatePrimitives = 0;
+        uint64_t emittedPrimitives = 0;
+        uint64_t primitivesRemoved = 0;
+        uint64_t structureCandidateCommands = 0;
+        uint64_t structureReusedCommands = 0;
+        uint64_t structureEmittedCommands = 0;
+        uint64_t structureCandidatePrimitives = 0;
+        uint64_t structureAvoidedPrimitives = 0;
+        uint64_t structureFallbackCount = 0;
+        FallbackReason structureFallbackReason = FallbackReason::NONE;
+        uint64_t javaSceneAdds = 0;
+        uint64_t javaSceneRemoves = 0;
+        uint64_t generationCount = 0;
+    };
+
+    void requestMode(Mode mode, uint64_t modeRevision) noexcept;
+    bool publishDecisions(Decision const* decisions, size_t count,
+            uint64_t decisionBufferRevision, bool replace) noexcept;
+    bool publishResidents(Resident const* residents, size_t count, bool replace) noexcept;
+    void clearDecisions(uint64_t decisionBufferRevision) noexcept;
+    void recordJavaSceneMutation(uint32_t adds, uint32_t removes) noexcept;
+    Readback getReadback() const noexcept;
+};
+
+} // namespace filament
+
+#endif // TNT_FILAMENT_CARDINALMANAGER_H
